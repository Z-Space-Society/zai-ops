# {{ ansible_managed }}
# Secret environment for the corliss systemd unit (EnvironmentFile). Root-only
# (0600); read by systemd before it drops to the corliss user, so the daemon
# never reads this file itself. Rendered by the corliss role — never edited
# on the CT (git pull on CT 100 + re-run provision.yml is the update story).

# Postgres store. IP DERIVED from the postgres CT's CTID via hostvars, never
# hardcoded. Migrations already ran at provision time (see tasks), so startup
# is just app boot + DB connect.
DATABASE_URL={{ corliss_database_url }}

# Signs Django sessions + CSRF tokens. Set explicitly (stable, from
# /root/.zai-secrets) so logins survive a rebuild.
SECRET_KEY={{ corliss_secret_key }}
DEBUG=false

# DEV_LOGIN_ENABLED is deliberately ABSENT, not set to false. It serves
# /auth/dev-login, which mints a session for any handle typed into a form — a
# complete authentication bypass that must never exist on the cluster, and the
# app defaults it off. Never add it here. Belt and braces: Corliss's own system
# check corliss.E001 hard-fails `manage.py check`/`migrate` if it is ever set
# without DEBUG, so this role's migrate task would fail the run outright.

ALLOWED_HOSTS={{ corliss_allowed_hosts | join(',') }}
CSRF_TRUSTED_ORIGINS={{ corliss_url }}

# Anchors the atproto OAuth client_id, the OIDC issuer, and the redirect/JWKS
# URLs — must be the public HTTPS origin Caddy fronts (the apex, {{ cluster_domain }}).
PUBLIC_BASE_URL={{ corliss_url }}

# The two OAuth/OIDC signing keys (PKCS8 PEM), rendered onto this CT by the
# role from the group_vars secrets. atproto mandates ES256 (P-256) for DPoP +
# client assertion; the OIDC id_token uses RS256 for broad OIDC-client compat.
ATPROTO_EC_PRIVATE_KEY_PATH={{ corliss_atproto_ec_key_path }}
OIDC_RSA_PRIVATE_KEY_PATH={{ corliss_oidc_rsa_key_path }}

# The one OIDC relying party today: Open WebUI. Secret is shared between this
# app and the open-webui role's OAUTH_CLIENT_SECRET (same group_vars value).
OIDC_CLIENT_ID={{ corliss_oidc_client_id }}
OIDC_CLIENT_SECRET={{ corliss_oidc_client_secret }}
OIDC_REDIRECT_URIS={{ corliss_oidc_redirect_uris | join(',') }}

# Where corliss links out to. Each is blank-tolerant on the app side (a blank
# value hides that link/block), so rendering all three unconditionally is safe
# even on a cluster where the surface isn't up yet.
CHAT_URL={{ corliss_chat_url }}
API_URL={{ corliss_api_url }}
MANAGE_URL={{ corliss_manage_url }}

# Bearer token the SCN registry presents when POSTing a grant or revocation to
# /membership/events, so corliss can cache who is a member. The registry pushes
# and corliss never pulls — a pull would need corliss to authenticate to
# HappyView as itself, which is unsolved.
#
# The same value must reach HappyView as the CORLISS_PUSH_TOKEN script
# variable, which `npm run deploy` in the scn-ops checkout installs — Ansible
# does not own that side. Until both sides are set the push is inert in the
# safe direction: corliss answers 503 and the registry's Lua logs the failure
# and completes the approval anyway, because the space record is the membership
# event and this is only a cache of it.
MEMBERSHIP_PUSH_TOKEN={{ corliss_membership_push_token }}

# The SCN service DID, whose atproto repo holds the public admin roster corliss
# reads to decide who sees the admin block. Public information, not a secret.
#
# Shared verbatim with the manage_console role (which passes the same value as
# VITE_SERVICE_DID) — one registry identity, recorded once, under one name in
# `inventory/local.yml` via `zai-set-console service_did <did>`. `default('')`
# because that runtime value is per-cluster: the blank blueprint default lives
# in the manage_console role, whose defaults this host doesn't load, and blank
# is a working state here (the roster is simply empty, so no one is elevated).
SCN_SERVICE_DID={{ scn_service_did | default('') }}

# Reading membership back OUT of the registry, which the push above cannot do: a
# corliss rebuilt from nothing has witnessed no pushes and those events already
# happened. Reconciliation is the only route by which membership re-enters a
# rebuilt corliss, so this is what makes the prime directive hold for membership.
#
# The URL is INTERNAL (one hop over vmbr1), not the public view.<domain> origin —
# see the role defaults for why the recovery path must not depend on public DNS,
# Cloudflare and the proxy CT. HOST is the price of that: happyview routes by
# virtual host and answers HTTP 421 "Unknown host" to a request whose Host is a
# bare 10.1.1.x, so the public name the edge would have preserved is presented
# explicitly here.
#
# The client key is OPTIONAL and blank is fully working, unlike the DID above.
# Verified against production 2026-08-18: HappyView dispatches to a Lua script
# with no session and no client key at all, so the token carries this on its own.
# It must stay optional — requiring it would mean a cluster rebuilt before
# `zai-set-console client_key` had been run could not reconcile, tying recovery
# to the console it replaces. Passed through when set, since it is the same
# `console_client_key` and not a second copy under a second name.
MEMBERSHIP_REGISTRY_URL={{ corliss_membership_registry_url }}
MEMBERSHIP_REGISTRY_HOST={{ corliss_membership_registry_host }}
MEMBERSHIP_REGISTRY_TOKEN={{ corliss_membership_registry_token }}
MEMBERSHIP_REGISTRY_CLIENT_KEY={{ console_client_key | default('') }}
