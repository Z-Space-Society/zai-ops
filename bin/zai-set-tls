#!/usr/bin/env bash
# zai-set-tls: thin wrapper over set-tls.yml. Record how the proxy edge gets its
# certificate:
#
#   zai-set-tls origin_ca                 # Cloudflare proxies the domain (vault cert/key)
#   zai-set-tls none                      # external edge in front, or pre-DNS smoke test
#   zai-set-tls acme ops@example.org      # Caddy's own Let's Encrypt certs, optional contact
#
# acme is the proxy role's default, so a cluster that never runs this gets acme.
#
# Lives in the repo's bin/ (on PATH via /etc/profile.d/zai-ops.sh) and runs in
# place, so the script you run is always the one in git, no installed copy to
# drift. No logic lives here; the playbook validates the mode and email and
# persists them.
set -euo pipefail
if [[ $# -lt 1 ]]; then
  echo "usage: zai-set-tls <mode> [email] [extra ansible args]" >&2
  echo "  modes: origin_ca | acme | none (email is for acme only)" >&2
  exit 64
fi
mode="$1"; shift
# The email is optional, so tell it apart from extra ansible args by the leading
# dash every ansible option has.
email=""
if [[ $# -gt 0 && "$1" != -* ]]; then
  email="$1"; shift
fi
# cd to the ansible dir (sibling of this bin/) so ansible.cfg loads no matter the
# caller's CWD: it supplies the inventory (relative: inventory/) and the vault
# password file. Self-locating off this script's path (not hardcoded) so the same
# script works from any checkout: /opt/zai-ops on the box, a dev tree elsewhere.
cd "$(dirname "$(readlink -f "$0")")/../ansible"
exec ansible-playbook set-tls.yml \
  -e "tls_mode=$mode" -e "acme_email=$email" "$@"
