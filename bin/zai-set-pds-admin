#!/usr/bin/env bash
# zai-set-pds-admin — thin wrapper over set-pds-admin.yml. Record who may
# administer the in-house PDS; each DID listed may drive the com.atproto.admin.*
# surface by signing a service-auth token with the #atproto key of their own DID
# document (PDS_ADMIN_DIDS).
#
#   zai-set-pds-admin did:plc:abc2…          # becomes THE admin list (replaces!)
#   zai-set-pds-admin did:plc:a,did:plc:b    # set several at once
#
# DIDs are public information (each admin's own DID document key), so they live
# in the runtime inventory, not the vault.
#
# Lives in the repo's bin/ (on PATH via /etc/profile.d/zai-ops.sh) and runs in
# place — the script you run is always the one in git, no installed copy to
# drift. No logic lives here; the playbook validates and persists the list.
set -euo pipefail
if [[ $# -lt 1 ]]; then
  echo "usage: zai-set-pds-admin <did:plc:…> [extra ansible args]" >&2
  exit 64
fi
did="$1"; shift
# cd to the ansible dir (sibling of this bin/) so ansible.cfg loads no matter the
# caller's CWD — it supplies the inventory (relative: inventory/) and the vault
# password file. Self-locating off this script's path (not hardcoded) so the same
# script works from any checkout: /opt/zai-ops on the box, a dev tree elsewhere.
cd "$(dirname "$(readlink -f "$0")")/../ansible"
exec ansible-playbook set-pds-admin.yml -e "did=$did" "$@"