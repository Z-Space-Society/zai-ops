# {{ ansible_managed }}
# Secret environment for the corliss systemd unit (EnvironmentFile). Root-only
# (0600); read by systemd before it drops to the corliss user, so the daemon
# never reads this file itself. Rendered by the corliss role — never edited
# on the CT (git pull on CT 100 + re-run provision.yml is the update story).

# Postgres store. IP DERIVED from the postgres CT's CTID via hostvars, never
# hardcoded. Migrations already ran at provision time (see tasks), so startup
# is just app boot + DB connect.
DATABASE_URL={{ corliss_database_url }}

# Signs Django sessions + CSRF tokens. Set explicitly (stable, from
# /root/.zai-secrets) so logins survive a rebuild.
SECRET_KEY={{ corliss_secret_key }}
DEBUG=false

# DEV_LOGIN_ENABLED is deliberately ABSENT, not set to false. It serves
# /auth/dev-login, which mints a session for any handle typed into a form — a
# complete authentication bypass that must never exist on the cluster, and the
# app defaults it off. Never add it here. Belt and braces: Corliss's own system
# check corliss.E001 hard-fails `manage.py check`/`migrate` if it is ever set
# without DEBUG, so this role's migrate task would fail the run outright.

ALLOWED_HOSTS={{ corliss_allowed_hosts | join(',') }}
CSRF_TRUSTED_ORIGINS={{ corliss_url }}

# Anchors the atproto OAuth client_id, the OIDC issuer, and the redirect/JWKS
# URLs — must be the public HTTPS origin Caddy fronts (the apex, {{ cluster_domain }}).
PUBLIC_BASE_URL={{ corliss_url }}

# The two OAuth/OIDC signing keys (PKCS8 PEM), rendered onto this CT by the
# role from the group_vars secrets. atproto mandates ES256 (P-256) for DPoP +
# client assertion; the OIDC id_token uses RS256 for broad OIDC-client compat.
ATPROTO_EC_PRIVATE_KEY_PATH={{ corliss_atproto_ec_key_path }}
OIDC_RSA_PRIVATE_KEY_PATH={{ corliss_oidc_rsa_key_path }}

# The one OIDC relying party today: Open WebUI. Secret is shared between this
# app and the open-webui role's OAUTH_CLIENT_SECRET (same group_vars value).
OIDC_CLIENT_ID={{ corliss_oidc_client_id }}
OIDC_CLIENT_SECRET={{ corliss_oidc_client_secret }}
OIDC_REDIRECT_URIS={{ corliss_oidc_redirect_uris | join(',') }}

# Drives the nav's "Chat" link on the login/account pages.
CHAT_URL={{ corliss_chat_url }}
