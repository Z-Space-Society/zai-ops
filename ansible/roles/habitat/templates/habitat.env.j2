# {{ ansible_managed }}
#
# pear reads every flag from a HABITAT_-prefixed env var, so the whole config
# surface is here and the unit's ExecStart carries no arguments. Flag names map
# to env names by uppercasing: --blob_bucket is HABITAT_BLOB_BUCKET.
#
# Five values are Required with no default (domain, pds_cred_encrypt_key,
# space_signing_key, oauth_server_secret, oauth_client_secret); pear refuses to
# start if any is empty, which is the intended loud failure.

# Public origin, no scheme. Baked into org DIDs and used as the OAuth issuer
# ("https://"+domain), so it is effectively immutable once an org exists.
HABITAT_DOMAIN={{ habitat_domain }}
HABITAT_PORT={{ habitat_port }}

# HTTPSCERTS is deliberately unset: Caddy terminates TLS at the edge and reaches
# this CT over vmbr1 on plain HTTP, which is upstream's own documented
# reverse-proxy posture. Setting it would make pear try to bind 443 itself.

HABITAT_DB={{ habitat_database_url }}
HABITAT_BLOB_BUCKET={{ habitat_blob_bucket }}

# The service name looked up in a user's DID doc service list.
HABITAT_SERVICE_NAME=habitat

{% if habitat_blob_use_garage | bool %}
# Garage credentials for the s3blob driver, which resolves them through the AWS
# default credential chain rather than from the bucket URL.
AWS_ACCESS_KEY_ID={{ habitat_s3_access_key }}
AWS_SECRET_ACCESS_KEY={{ habitat_s3_secret_key }}
AWS_DEFAULT_REGION={{ habitat_s3_region }}
{% endif %}

# --- Secrets ---------------------------------------------------------------
# All generate-once and immutable. Rotating either of the first two orphans data:
# the PDS credential key decrypts stored PDS credentials, and the space signing
# key signs permissioned-repo commits for repo owners on external PDSes.
HABITAT_PDS_CRED_ENCRYPT_KEY={{ habitat_pds_cred_encrypt_key }}
HABITAT_SPACE_SIGNING_KEY={{ habitat_space_signing_key }}
HABITAT_OAUTH_SERVER_SECRET={{ habitat_oauth_server_secret }}
HABITAT_OAUTH_CLIENT_SECRET={{ habitat_oauth_client_secret }}

# Instance admin. Set explicitly because the alternative is worse than it sounds:
# with this unset pear generates a random password on every boot and prints it
# once to stdout, which under systemd means it lands in the journal and changes
# on every restart. Upstream keeps it in memory only and never persists it, so
# this env var is the only way to have a stable admin login.
HABITAT_ADMIN_PASSWORD={{ habitat_admin_password }}

HABITAT_DEBUG=false
