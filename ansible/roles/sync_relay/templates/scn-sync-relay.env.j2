# {{ ansible_managed }}
# scn-sync-relay runtime configuration. Read by systemd via EnvironmentFile
# before the process drops privilege — never world-readable (0600 root:root).

SCN_SYNC_RELAY_DATABASE_URL={{ sync_relay_database_url }}
SCN_SYNC_RELAY_BIND={{ sync_relay_host }}:{{ sync_relay_port }}

# Phase B. With auth on, the relay refuses to start if any setting below is
# blank, so a half-rendered file fails the smoke test rather than serving open.
SCN_SYNC_RELAY_REQUIRE_AUTH={{ sync_relay_require_auth | string | lower }}
SCN_SYNC_RELAY_OIDC_ISSUER={{ sync_relay_oidc_issuer }}
SCN_SYNC_RELAY_OIDC_JWKS_URL={{ sync_relay_oidc_jwks_url }}
SCN_SYNC_RELAY_SYNC_AUDIENCE={{ sync_relay_sync_audience }}
SCN_SYNC_RELAY_MCP_AUDIENCE={{ sync_relay_mcp_audience }}
SCN_SYNC_RELAY_MCP_BIND={{ sync_relay_host }}:{{ sync_relay_mcp_port }}

# Corliss presents this on /internal/vaults. The same group_vars value Corliss
# renders as SYNC_RELAY_SERVICE_TOKEN.
SCN_SYNC_RELAY_SERVICE_TOKEN={{ sync_relay_service_token }}

RUST_LOG=scn_sync_relay=info,samod=info
