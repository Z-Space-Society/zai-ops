{{ ansible_managed | comment }}
# Build-time config for the SCN admin console. Vite reads this file from the
# project root and inlines every VITE_* into the bundle, and `prebuild`
# (scripts/client-metadata.mjs) reads it to generate public/client-metadata.json.
#
# Nothing here is a secret — every value ships to the browser or is published at
# a public URL. Do not add one; a secret in this file would be a secret in the
# bundle. The registry's write credential is the ADMIN'S OWN atproto session,
# obtained in the browser at sign-in, which is the whole reason the console can
# be a static bundle at all.

VITE_HAPPYVIEW_URL={{ manage_console_happyview_url }}
VITE_HV_CLIENT_KEY={{ console_client_key }}

# An https:// client id makes scripts/client-metadata.mjs emit
# public/client-metadata.json; the loopback dev client (an unset client id) is
# the one case where it skips, which is why a deploy has to assert the file
# exists rather than trust an exit 0.
VITE_OAUTH_CLIENT_ID={{ manage_console_client_id }}
VITE_OAUTH_REDIRECT_URI={{ manage_console_redirect_uri }}
VITE_OAUTH_SCOPE={{ manage_console_scope }}

VITE_SERVICE_DID={{ scn_service_did }}
VITE_REGISTRY_SPACE_URI={{ scn_registry_space_uri }}
