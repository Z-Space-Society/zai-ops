# {{ ansible_managed }}
# Secret environment for the open-webui systemd unit (EnvironmentFile). Root-only
# (0600); read by systemd before it drops to the open-webui user, so the daemon never
# reads this file itself. Rendered by the open-webui role — never edited on the CT.
# OpenWebUI has no config file: it is configured entirely by these variables.

# Postgres store (users, chats, settings). IP DERIVED from the postgres CT's CTID via
# hostvars, never hardcoded. OpenWebUI runs its Alembic migrations against this on
# startup, so the DB + role must already exist — the role provisions them earlier.
DATABASE_URL={{ openwebui_database_url }}

# Signs OpenWebUI's session JWTs. Set EXPLICITLY (stable, from /root/.zai-secrets) so
# logins survive a rebuild — unset, OpenWebUI writes a random key into DATA_DIR that a
# fresh CT would regenerate, invalidating every existing session.
WEBUI_SECRET_KEY={{ openwebui_secret_key }}

# --- Model backend: the litellm gateway (chat + RAG embeddings) -------------------
# One OpenAI-compatible upstream for everything. Ollama probing is off (we have no
# Ollama); the key is a scoped, non-admin litellm virtual key (F1) — never the
# master key.
ENABLE_OPENAI_API=true
ENABLE_OLLAMA_API=false
OPENAI_API_BASE_URL={{ openwebui_openai_base_url }}
OPENAI_API_KEY={{ openwebui_openai_api_key }}

# Forwards the logged-in member's id/email/name to litellm on every request, so
# litellm can attribute spend/usage per person (an auto-created "End User"
# record) even though every request rides the one shared key above.
ENABLE_FORWARD_USER_INFO_HEADERS={{ openwebui_forward_user_info_headers | lower }}

# RAG embeddings via litellm (engine=openai) rather than OpenWebUI's local
# sentence-transformers model — no multi-GB model download, and embeddings track
# litellm's availability. The model name must match what litellm serves.
RAG_EMBEDDING_ENGINE={{ openwebui_rag_embedding_engine }}
RAG_EMBEDDING_MODEL={{ openwebui_rag_embedding_model }}
RAG_OPENAI_API_BASE_URL={{ openwebui_openai_base_url }}
RAG_OPENAI_API_KEY={{ openwebui_openai_api_key }}

# --- OIDC login: corliss is the ONLY way in ---------------------------------------
# corliss is the cluster's sole identity provider (ATProto handle -> OIDC id_token).
# Local signup/login are disabled so there is exactly one account per member, keyed
# by their DID — see docs/decisions/0005-zai-auth-over-aip.md.
#
# ENABLE_PERSISTENT_CONFIG=false is load-bearing: ENABLE_LOGIN_FORM, ENABLE_SIGNUP
# and friends are "PersistentConfig" values OpenWebUI reads from the environment
# only on its very first boot, then writes to its own DB and reads from THERE on
# every restart after — silently ignoring this file on every subsequent
# provision.yml run. false makes it always trust the environment, matching this
# repo's whole model (config lives in git, not a mutable runtime DB) — same
# reasoning as the proxy role's git-tracked Caddyfile.
ENABLE_PERSISTENT_CONFIG=false
ENABLE_OAUTH_SIGNUP=true
ENABLE_SIGNUP=false
ENABLE_LOGIN_FORM=false
OAUTH_CLIENT_ID={{ openwebui_oidc_client_id }}
OAUTH_CLIENT_SECRET={{ openwebui_oidc_client_secret }}
OPENID_PROVIDER_URL={{ openwebui_oidc_provider_url }}
OAUTH_PROVIDER_NAME=ZAI
OAUTH_SCOPES=openid email profile
OAUTH_USERNAME_CLAIM=handle
OAUTH_EMAIL_CLAIM=email
DEFAULT_USER_ROLE=user

# Lifetime of OpenWebUI's own session JWT — NOT corliss's session. Once the OIDC
# exchange completes, chat authenticates from this token and corliss is not asked
# again until it expires. Back-channel logout below now ends that session on
# sign-out and revocation, but only when the message gets through, so this stays
# the bound that holds when it doesn't. Keep it short. See
# openwebui_jwt_expires_in for the three specific paths it still covers.
JWT_EXPIRES_IN={{ openwebui_jwt_expires_in }}

# --- OIDC back-channel logout ------------------------------------------------
# Exposes POST /oauth/backchannel-logout. corliss POSTs a signed logout_token
# there when a member signs out or is revoked; OpenWebUI validates it against
# corliss's discovery document + JWKS and ends the session. This is what makes
# revocation immediate instead of bounded by JWT_EXPIRES_IN above.
ENABLE_OAUTH_BACKCHANNEL_LOGOUT={{ openwebui_enable_oauth_backchannel_logout | lower }}

# Redis is the half that makes the above mean anything: it is where OpenWebUI
# records that every token issued for a user before now is dead. Without it a
# logout token only deletes stored OAuth sessions, and the browser's JWT — the
# thing actually authenticating the revoked member — keeps working.
#
# This is a HARD dependency of the whole chat surface, not a cache. OpenWebUI
# consults Redis on every authenticated request once this is set, so an
# unreachable Redis 500s chat rather than degrading it. See docs/roles/redis.md.
REDIS_URL={{ openwebui_redis_url }}
REDIS_KEY_PREFIX={{ openwebui_redis_key_prefix }}

# Both are UNSET upstream, which means no timeout: against a redis CT that is
# down, every authenticated request blocks for the OS TCP timeout (~130s) before
# failing. Set explicitly so an outage fails fast and legibly instead of hanging.
REDIS_SOCKET_CONNECT_TIMEOUT={{ openwebui_redis_socket_connect_timeout }}
REDIS_SOCKET_TIMEOUT={{ openwebui_redis_socket_timeout }}

# ENABLE_STAR_SESSIONS_MIDDLEWARE is deliberately ABSENT, not set to false.
# It defaults off INDEPENDENTLY of REDIS_URL, which is the property this
# deployment relies on: with it off, the OAuth login handshake's own state
# (the `state` parameter, the nonce) stays in a signed cookie, so Redis sits on
# the authenticated-request path but NOT on the login path. Turning it on would
# put a redis round-trip between a member and the login form itself, which is
# the one place this stack works hardest to keep dependency-free. Never add it.

# --- Runtime paths + public URL ---------------------------------------------------
# DATA_DIR is the unit's one writable path; HF_HOME/SENTENCE_TRANSFORMERS_HOME point
# inside it so any library cache lands in a path writable under ProtectSystem=strict.
DATA_DIR={{ openwebui_data_dir }}
HF_HOME={{ openwebui_hf_home }}
SENTENCE_TRANSFORMERS_HOME={{ openwebui_hf_home }}
WEBUI_URL={{ openwebui_url }}
HOST={{ openwebui_host }}
PORT={{ openwebui_port }}

# Migrations run automatically on startup (the default) — made explicit for clarity.
ENABLE_DB_MIGRATIONS=true
