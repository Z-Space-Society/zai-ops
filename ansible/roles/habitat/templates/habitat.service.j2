# {{ ansible_managed }}
[Unit]
Description=Habitat Organizational Data Server (pear)
After=network-online.target
Wants=network-online.target

[Service]
User={{ habitat_user }}
Group={{ habitat_group }}
EnvironmentFile={{ habitat_env_file }}
WorkingDirectory={{ habitat_home }}
ExecStart={{ habitat_bin }}
# Restart=always rather than on-failure, same reasoning as the sync relay: a
# clean exit for any reason other than SIGTERM, Postgres not yet reachable at
# startup being the likely one, is still an outage, and pear re-runs its goose
# migrations and re-reads all state on start, so recovery costs nothing.
Restart=always
RestartSec=5
TimeoutStartSec=90

NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
{% if habitat_blob_use_garage | bool %}
# No ReadWritePaths at all: with blobs on Garage the service's entire state is in
# Postgres and S3, so ProtectSystem=strict alone is the whole hardening story.
# Same posture as the sync relay.
{% else %}
# Local-disk blobs, so the blob directory is the one path the daemon writes to.
# Narrower than happyview's ReadWritePaths on purpose: nothing under /opt/habitat
# needs to be writable at runtime, since the binary and source tree are
# root-owned build output.
ReadWritePaths={{ habitat_blob_dir }}
{% endif %}

[Install]
WantedBy=multi-user.target
