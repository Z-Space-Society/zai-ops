# {{ ansible_managed }}
# Runtime config for the in-house PDS (atproto-pds). Read by systemd via
# EnvironmentFile before the process drops privilege — never world-readable
# (0600 root:root on disk). Secrets resolve from the control node's
# /root/.zai-secrets (group_vars/all/main.yml); nothing secret is committed.
PDS_BIND={{ pds_host }}
PDS_PORT={{ pds_port }}
PDS_DATA_DIRECTORY={{ pds_data_dir }}
PDS_PRODUCTION=true
PDS_SERVICE_DID={{ pds_service_did }}
PDS_HOSTNAME={{ pds_hostname }}
PDS_DID_PLC_URL={{ pds_did_plc_url }}
PDS_DURABILITY_PROFILE=sql
# Invites on from first boot — a PLC DID made by a stray test is permanent and
# public, so the door stays locked until an operator mints a code.
PDS_INVITE_REQUIRED=true
PDS_CRAWLERS={{ pds_crawlers | join(',') }}
PDS_BSKY_APP_VIEW_DID={{ pds_bsky_app_view_did }}
PDS_BSKY_APP_VIEW_URL={{ pds_bsky_app_view_url }}
PDS_SERVICE_HANDLE_DOMAINS={{ pds_handle_domains | join(',') }}
# This server sits behind exactly one reverse-proxy hop (the cluster Caddy),
# for client-IP maths (rate limiting). Inflating this lets a caller forge their
# address; zero breaks anything that needs the client IP.
PDS_TRUSTED_PROXY_HOPS=1
PDS_BLOB_UPLOAD_LIMIT={{ pds_blob_upload_limit }}
PDS_IMPORT_LIMIT={{ pds_import_limit }}
# Admin CLI target + delegated admins (their own DIDs; public, not secrets).
# The list is the cluster admin roster's current admins, read by provision.yml's
# pds play (tasks/roster.yml). When it is empty the line is left out.
PDS_ADMIN_BASE_URL=http://127.0.0.1:{{ pds_port }}
{% if pds_admin_dids | default([], true) %}
PDS_ADMIN_DIDS={{ pds_admin_dids | join(',') }}
{% endif %}
# --- Secrets (from /root/.zai-secrets) --------------------------------------
PDS_JWT_SECRET={{ pds_jwt_secret }}
PDS_ADMIN_PASSWORD={{ pds_admin_password }}
{# The OAuth signing key, always ours (docs/decisions/0011): adopted from the
   server's own key store on a PDS that already ran, so the published key does
   not change. Current key first, which signs; a key being rotated out follows
   and is only published. One line: an EnvironmentFile value cannot span lines.
   The PLC rotation key is emitted only when set, which it is once we must
   update hosted identities' DID documents (the SCN DID migration). #}
PDS_OAUTH_KEYS_JWK_SET={{ {'keys': pds_oauth_keys | map('private_jwk') | list} | to_json }}
{% if pds_plc_rotation_key_private | default('', true) %}
PDS_PLC_ROTATION_KEY_PRIVATE={{ pds_plc_rotation_key_private }}
{% endif %}

{# Account delegation, on by default. Needs an HTTPS origin (Caddy) and a
   P-256 OAuth key. A fresh install gets one from the signing_keys lookup; a
   K-256 key adopted from an old build needs `scn-config rotate-key pds_oauth`,
   which puts a P-256 key in front of it. #}
PDS_DELEGATION_ENABLED={{ pds_delegation_enabled | bool | lower }}

{# Outbound mail: both the cluster relay URL (smtp_url, a secret) and the From
   address must be set, or the server logs and drops every message. #}
{% if pds_email_smtp_url | default('', true) and pds_email_from_address | default('', true) %}
PDS_EMAIL_SMTP_URL={{ pds_email_smtp_url }}
PDS_EMAIL_FROM_ADDRESS={{ pds_email_from_address }}
{% endif %}
RUST_LOG=info,atproto_pds=info