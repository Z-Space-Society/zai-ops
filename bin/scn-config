#!/usr/bin/env bash
# scn-config — the cluster's configuration tool, patterned on raspi-config.
#
#   scn-config                                   # the menu
#   scn-config nonint setup                      # configure this node, then check
#                                                #   the Proxmox API token
#   scn-config nonint show-proxmox-host          # the Proxmox host's own name
#   scn-config nonint set-proxmox-host asusnuc   # a correction: bootstrap sets it
#   scn-config nonint show-domain                # the cluster's public base domain,
#                                                #   and where handles go
#   scn-config nonint set-domain example.com
#   scn-config nonint set-handle-domain example.net [--no-cluster-domain]
#   scn-config nonint clear-handle-domain        # handles back under the cluster domain
#   scn-config nonint show-registry              # the membership registry's identity
#   scn-config nonint set-registry service_did did:plc:…   # or client_key hvc_…;
#                                                #   an empty value records none
#   scn-config nonint show-ctid                  # service / CTID / default table
#   scn-config nonint assign-ctid proxy 110      # assign one service
#   scn-config nonint assign-ctid-defaults       # assign every unassigned service
#                                                #   its blueprint default
#   scn-config nonint show-admins                # the cluster's admins
#   scn-config nonint add-admin alice.example.com    # handle or DID
#   scn-config nonint remove-admin alice.example.com
#   scn-config nonint apply-admins               # give the list to everything that
#   scn-config nonint apply-admins pds           #   keeps a copy, or only to some
#   scn-config nonint show-smtp                  # the mail relay, minus credentials
#   scn-config nonint set-smtp < url-file        # the relay URL, read from stdin
#   scn-config nonint clear-smtp                 # remove it; mail off
#   scn-config nonint set-alert-email ops@example.org  # where the monitoring
#   scn-config nonint clear-alert-email          #   hub mails alerts; off when empty
#   scn-config nonint show-scn-chat-key          # whether scn-chat's admin key is set
#   scn-config nonint set-scn-chat-key < key-file    # the key, read from stdin
#   scn-config nonint clear-scn-chat-key         # remove it; scn-chat cron off
#   scn-config nonint show-tls                   # how the proxy gets its certificate
#   scn-config nonint set-tls acme ops@example.org   # acme (the default, contact
#                                                #   optional) or none
#   scn-config nonint show-keys                  # each signing key and its state
#   scn-config nonint rotate-key pds_oauth       # new key in front, old one kept
#   scn-config nonint retire-key pds_oauth       # drop the old one
#   scn-config nonint show-versions              # each service's deployed version,
#                                                #   and what scn-chat/corliss are set to
#   scn-config nonint set-version scn-chat v0.2.2    # a release tag, or latest
#   scn-config nonint clear-version scn-chat     # back to the role default
#   scn-config nonint apply-monitor-agents       # the Beszel agent everywhere,
#   scn-config nonint apply-monitor-agents proxy #   or only on some hosts
#   scn-config nonint print-monitor-agent-install salmon  # a root script that
#                                                #   installs the agent on a machine
#                                                #   Ansible doesn't manage (holds the
#                                                #   agent token)
#
# Runs on the control node. Lives in the repo's bin/ (on PATH via
# /etc/profile.d/zai-ops.sh) and runs in place — the script you run is always the
# one in git, no installed copy to drift.
#
# This is the front end only. The playbooks (site.yml, verify-proxmox.yml,
# set-domain.yml, set-handle-domain.yml, set-registry.yml, set-node.yml, assign.yml, admins.yml,
# set-smtp.yml, set-scn-chat-key.yml, set-tls.yml, rotate-key.yml, set-version.yml,
# monitor-agent.yml) validate and write; the checks here exist to give a readable message before a playbook
# run, and the playbook stays the authority.
set -euo pipefail

# cd to the ansible dir (sibling of this bin/) so ansible.cfg loads no matter the
# caller's CWD — it supplies the inventory (relative: inventory/) and the vault
# password file. Self-locating off this script's path (not hardcoded) so the same
# script works from any checkout: /opt/zai-ops on the box, a dev tree elsewhere.
cd "$(dirname "$(readlink -f "$0")")/../ansible"

TITLE="SCN Configuration Tool (scn-config)"
# The same `git describe` the service manifests record (zai_ops_revision in
# group_vars/all/main.yml), so the version here and on Corliss's /systems/ agree.
VERSION="$(git describe --tags --always --dirty 2>/dev/null || echo unknown)"
BACKTITLE="Shared Computer Network — $(hostname) — zai-ops $VERSION"

# Shown wherever a recorded assignment could be changed. The CTID is the
# container's VMID and its address, so this is a migration, not a setting.
REASSIGN_WARNING="Changing a recorded assignment does not move a provisioned
container: the next provision creates a second, empty one at the new CTID, the
old one keeps the data, and every other service still points at the old address.
Only safe before the service has been provisioned."

die() { echo "scn-config: $*" >&2; exit 1; }

usage() {
  cat >&2 <<'EOF'
usage: scn-config
       scn-config nonint setup
       scn-config nonint show-proxmox-host
       scn-config nonint set-proxmox-host <name>
       scn-config nonint show-domain
       scn-config nonint set-domain <domain>
       scn-config nonint set-handle-domain <domain> [--no-cluster-domain]
       scn-config nonint clear-handle-domain
       scn-config nonint show-registry
       scn-config nonint set-registry <client_key|service_did> <value>
       scn-config nonint show-ctid
       scn-config nonint assign-ctid <service> <ctid> [--reassign]
       scn-config nonint assign-ctid-defaults
       scn-config nonint show-admins
       scn-config nonint add-admin <handle-or-did> [--admit] [--tier <tier>]
       scn-config nonint remove-admin <handle-or-did>
       scn-config nonint apply-admins [corliss] [pds]
       scn-config nonint show-smtp
       scn-config nonint set-smtp        (URL on stdin)
       scn-config nonint clear-smtp
       scn-config nonint show-scn-chat-key
       scn-config nonint set-scn-chat-key        (key on stdin)
       scn-config nonint clear-scn-chat-key
       scn-config nonint show-tls
       scn-config nonint set-tls <acme|none> [email]
       scn-config nonint show-keys
       scn-config nonint rotate-key <key>
       scn-config nonint retire-key <key>
       scn-config nonint show-versions
       scn-config nonint set-version <scn-chat|corliss> <tag|latest>
       scn-config nonint clear-version <scn-chat|corliss>
       scn-config nonint apply-monitor-agents [host...]
       scn-config nonint print-monitor-agent-install <machine>
       scn-config nonint set-alert-email <address>
       scn-config nonint clear-alert-email
EOF
  exit 64
}

# --- State -------------------------------------------------------------------
# Parallel arrays, one entry per blueprint service, ordered by CTID (assigned,
# else default). SVC_CTID / SVC_DEFAULT hold "" when there is none.
SVC_NAME=() SVC_CTID=() SVC_DEFAULT=()
RESERVED=" "   # space-delimited, space-padded for `case` membership tests
# What local.yml records under all.vars, "" when it records nothing. An empty
# TLS_MODE is not "no TLS": the proxy role's default (acme) applies, and a role
# default is not in the inventory to be read.
CLUSTER_DOMAIN="" TLS_MODE="" TLS_EMAIL=""
# Empty HANDLE_DOMAIN: handles go under the cluster domain (the pds default).
HANDLE_DOMAIN="" HANDLE_ALLOW_CLUSTER=true
REGISTRY_SERVICE_DID="" REGISTRY_CLIENT_KEY="" PROXMOX_HOST=""

# Read the merged inventory (blueprint + runtime local.yml) in one call. python3
# rather than jq: Ansible guarantees python on the control node, while jq only
# arrives with site.yml and this must work straight after bootstrap.
load_state() {
  local json err line kind name ctid default
  # Keep ansible's own complaint: "could not read the inventory" alone sends
  # the operator off to rerun the command from the wrong directory.
  err="$(mktemp)"
  if ! json="$(ansible-inventory --list 2>"$err")"; then
    cat "$err" >&2; rm -f "$err"
    die "could not read the inventory (ansible-inventory --list, run in $PWD)"
  fi
  rm -f "$err"
  SVC_NAME=() SVC_CTID=() SVC_DEFAULT=() RESERVED=" "
  CLUSTER_DOMAIN="" TLS_MODE="" TLS_EMAIL=""
  HANDLE_DOMAIN="" HANDLE_ALLOW_CLUSTER=true
  REGISTRY_SERVICE_DID="" REGISTRY_CLIENT_KEY="" PROXMOX_HOST=""
  while read -r kind name ctid default; do
    case "$kind" in
      reserved) RESERVED="${RESERVED}${name} " ;;
      var)
        case "$name" in
          cluster_domain) CLUSTER_DOMAIN="$ctid" ;;
          pds_handle_domain) HANDLE_DOMAIN="$ctid" ;;
          pds_handle_allow_cluster_domain) HANDLE_ALLOW_CLUSTER="$ctid" ;;
          caddy_tls_mode) TLS_MODE="$ctid" ;;
          caddy_acme_email) TLS_EMAIL="$ctid" ;;
          scn_service_did) REGISTRY_SERVICE_DID="$ctid" ;;
          registry_client_key) REGISTRY_CLIENT_KEY="$ctid" ;;
          proxmox_node_name) PROXMOX_HOST="$ctid" ;;
        esac
        ;;
      svc)
        SVC_NAME+=("$name")
        SVC_CTID+=("${ctid#-}")
        SVC_DEFAULT+=("${default#-}")
        ;;
    esac
  done < <(python3 -c '
import json, sys
inv = json.load(sys.stdin)
hostvars = inv.get("_meta", {}).get("hostvars", {})
rows, reserved = [], []
for name in inv.get("service_containers", {}).get("hosts", []):
    hv = hostvars.get(name, {})
    reserved = hv.get("reserved_ctids", reserved)
    rows.append((name, hv.get("ctid"), hv.get("default_ctid")))
rows.sort(key=lambda r: (r[1] or r[2] or 1000, r[0]))
for r in reserved:
    print("reserved", r)
# all.vars reaches every host, so any host that carries the key has the value.
for key in ("cluster_domain", "caddy_tls_mode", "caddy_acme_email",
            "scn_service_did", "registry_client_key", "proxmox_node_name",
            "pds_handle_domain"):
    value = next((hv[key] for hv in hostvars.values() if hv.get(key)), None)
    if value:
        print("var", key, value)
# A boolean, so present-and-false matters: print it whenever it is recorded.
key = "pds_handle_allow_cluster_domain"
value = next((hv[key] for hv in hostvars.values() if key in hv), None)
if value is not None:
    print("var", key, "true" if value in (True, "true", "True", "yes") else "false")
for name, ctid, default in rows:
    print("svc", name, ctid or "-", default or "-")
' <<<"$json")
  [ "${#SVC_NAME[@]}" -gt 0 ] || die "the blueprint has no service_containers"
}

# index_of <service> — echo its index in SVC_*, or fail.
index_of() {
  local i
  for i in "${!SVC_NAME[@]}"; do
    [ "${SVC_NAME[$i]}" = "$1" ] && { echo "$i"; return 0; }
  done
  return 1
}

# assigned_holder <ctid> — echo the service already recorded at that CTID.
assigned_holder() {
  local i
  for i in "${!SVC_NAME[@]}"; do
    [ "${SVC_CTID[$i]}" = "$1" ] && { echo "${SVC_NAME[$i]}"; return 0; }
  done
  return 1
}

# ctid_problem <ctid> — echo why a CTID can't be handed out; silent if it can.
ctid_problem() {
  local holder
  if ! [[ "$1" =~ ^[0-9]+$ ]] || [ "$1" -lt 100 ] || [ "$1" -gt 999 ]; then
    echo "must be a number from 100 to 999"
  elif [[ "$RESERVED" == *" $1 "* ]]; then
    echo "$1 is reserved (reserved_ctids)"
  elif holder="$(assigned_holder "$1")"; then
    echo "$1 is already assigned to $holder"
  fi
}

# usable_default <index> — echo the service's default if it is free to propose.
usable_default() {
  local default="${SVC_DEFAULT[$1]}"
  [ -n "$default" ] && [ -z "$(ctid_problem "$default")" ] && echo "$default"
  return 0
}

# --- The engine --------------------------------------------------------------
# The pending request: parallel arrays of service → CTID.
P_NAME=() P_CTID=()

# Service names come from the inventory and CTIDs are validated numeric, so
# neither needs JSON escaping.
assignments_json() {
  local i out=""
  for i in "${!P_NAME[@]}"; do
    out="${out:+$out,}\"${P_NAME[$i]}\":${P_CTID[$i]}"
  done
  echo "{\"assignments\":{${out}}}"
}

# run_assign [extra ansible args] — hand the pending request to assign.yml.
run_assign() {
  ansible-playbook assign.yml -e "$(assignments_json)" "$@"
}

# --- Control node setup -------------------------------------------------------
# The first thing done on every cluster: configure this node (site.yml), then
# prove the API token works (verify-proxmox.yml) before anything is built with
# it. The check is skipped when the configure fails, since it would be testing
# a node that is not set up.
run_setup() {
  printf '\n=== scn-config: configuring the control node (site.yml) ===\n\n'
  if ! ansible-playbook site.yml </dev/null; then
    echo
    echo "scn-config: configuring the control node FAILED — see the output above."
    echo "scn-config: not run: the Proxmox API check"
    return 1
  fi
  printf '\n=== scn-config: checking the Proxmox API token (verify-proxmox.yml) ===\n\n'
  if ! ansible-playbook verify-proxmox.yml </dev/null; then
    echo
    echo "scn-config: the Proxmox API check FAILED — see the output above."
    return 1
  fi
  echo
  echo "scn-config: the control node is configured and the API token authenticates."
}

# --- Cluster settings and TLS -------------------------------------------------
set_domain() { ansible-playbook set-domain.yml -e "domain=$1"; }

# set_handle_domain <domain> [allow_cluster_domain] — an empty domain clears it,
# and handles go back under the cluster domain.
set_handle_domain() {
  ansible-playbook set-handle-domain.yml -e "handle_domain=$1" \
    -e "allow_cluster_domain=${2:-true}"
}

# handle_domain_summary — where handles go, said for a menu row or show-domain.
handle_domain_summary() {
  if [ -z "$HANDLE_DOMAIN" ]; then
    echo "${CLUSTER_DOMAIN:-the cluster domain} (same as the cluster domain)"
  elif [ "$HANDLE_ALLOW_CLUSTER" = false ]; then
    echo "$HANDLE_DOMAIN only"
  else
    echo "$HANDLE_DOMAIN, then ${CLUSTER_DOMAIN:-the cluster domain}"
  fi
}

# set_registry <client_key|service_did> <value> — an empty value records none.
# The playbook writes registry_client_key and scn_service_did, and first moves
# a client key still recorded under its old name, console_client_key.
set_registry() { ansible-playbook set-registry.yml -e "key=$1" -e "value=$2"; }

# The operator sees "Proxmox host name"; the playbook and the variable it
# writes (proxmox_node_name) use Proxmox's own word for it, node.
set_proxmox_host() { ansible-playbook set-node.yml -e "node=$1"; }
PROXMOX_HOST_RE='^[A-Za-z0-9]([A-Za-z0-9-]*[A-Za-z0-9])?$'

# set_tls <mode> [email] — the email is always passed, empty included: that is
# how set-tls.yml knows to drop a contact recorded earlier.
set_tls() { ansible-playbook set-tls.yml -e "tls_mode=$1" -e "acme_email=${2:-}"; }

# proxy_tls_label <acme|none>: how to say it to a person.
proxy_tls_label() {
  case "$1" in
    acme) echo "Caddy's own Let's Encrypt certificates" ;;
    none) echo "plain HTTP, no certificate" ;;
    *) echo "$1" ;;
  esac
}

proxy_tls_summary() {
  if [ -z "$TLS_MODE" ]; then
    echo "acme — $(proxy_tls_label acme) (the default; nothing recorded)"
  else
    echo "$TLS_MODE — $(proxy_tls_label "$TLS_MODE")${TLS_EMAIL:+, contact $TLS_EMAIL}"
  fi
}

# playbook_problem <output> — the sentence a setter playbook refused with, or
# the tail of its output when it failed some other way.
playbook_problem() {
  local problem
  problem="$(grep -a -m1 'Action failed:' <<<"$1" | sed 's/.*Action failed: //')"
  echo "${problem:-$(tail -n 8 <<<"$1")}"
}

# --- Non-interactive mode ----------------------------------------------------
nonint_show_domain() {
  load_state
  echo "cluster domain: ${CLUSTER_DOMAIN:-not set}"
  echo "handle domains: $(handle_domain_summary)"
}

nonint_set_domain() {
  [ $# -eq 1 ] || usage
  set_domain "$1"
}

nonint_set_handle_domain() {
  case "$#:${2:-}" in
    1:) set_handle_domain "$1" true ;;
    2:--no-cluster-domain) set_handle_domain "$1" false ;;
    *) usage ;;
  esac
}

nonint_clear_handle_domain() {
  [ $# -eq 0 ] || usage
  set_handle_domain ""
}

nonint_show_registry() {
  load_state
  echo "registry service DID: ${REGISTRY_SERVICE_DID:-not set}"
  echo "registry client key:  ${REGISTRY_CLIENT_KEY:-not set}"
}

nonint_set_registry() {
  [ $# -eq 2 ] || usage
  set_registry "$1" "$2"
}

nonint_show_proxmox_host() {
  load_state
  echo "Proxmox host name: ${PROXMOX_HOST:-not set}"
}

nonint_set_proxmox_host() {
  [ $# -eq 1 ] || usage
  set_proxmox_host "$1"
}

nonint_show_tls() {
  load_state
  echo "proxy TLS: $(proxy_tls_summary)"
}

nonint_set_tls() {
  [ $# -ge 1 ] && [ $# -le 2 ] || usage
  set_tls "$@"
}

nonint_show_ctid() {
  local i
  load_state
  printf '%-14s %-6s %s\n' SERVICE CTID DEFAULT
  for i in "${!SVC_NAME[@]}"; do
    printf '%-14s %-6s %s\n' "${SVC_NAME[$i]}" "${SVC_CTID[$i]:--}" "${SVC_DEFAULT[$i]:--}"
  done
}

nonint_assign_ctid() {
  [ $# -ge 2 ] || usage
  [[ "$2" =~ ^[0-9]+$ ]] || die "ctid must be a number (got '$2')"
  P_NAME=("$1") P_CTID=("$((10#$2))")   # 10#: a leading zero is not octal
  shift 2
  case "${1:-}" in
    "") run_assign ;;
    --reassign)
      printf '%s\n\n' "WARNING: $REASSIGN_WARNING" >&2
      run_assign -e reassign=true
      ;;
    *) usage ;;
  esac
}

nonint_assign_ctid_defaults() {
  local i default
  load_state
  P_NAME=() P_CTID=()
  for i in "${!SVC_NAME[@]}"; do
    [ -z "${SVC_CTID[$i]}" ] || continue
    default="$(usable_default "$i")"
    if [ -n "$default" ]; then
      P_NAME+=("${SVC_NAME[$i]}") P_CTID+=("$default")
    else
      echo "skipping ${SVC_NAME[$i]}: no free default — assign it by hand" >&2
    fi
  done
  if [ "${#P_NAME[@]}" -eq 0 ]; then
    echo "Nothing to assign."
    return 0
  fi
  run_assign
}

# --- Cluster admins ----------------------------------------------------------
# The roster is Corliss's to read and write (admins.yml runs its commands on the
# corliss CT), so everything shown here is Corliss's answer, in its own words.
ADMIN_RC=1 ADMIN_OUT="" ADMIN_ERR=""
ADM_DID=() ADM_HANDLE=() ADM_MEMBER=() ADM_NOTE=""

HANDLE_RE='^[a-z0-9]([a-z0-9-]*[a-z0-9])?(\.[a-z0-9]([a-z0-9-]*[a-z0-9])?)+$'
DID_RE='^did:(plc:[a-z2-7]{24}|web:[A-Za-z0-9.%:-]+)$'

# admins_run <ansible args> — run admins.yml; Corliss's exit status, output and
# complaint land in ADMIN_RC / ADMIN_OUT / ADMIN_ERR.
admins_run() {
  local out log field
  out="$(mktemp)" log="$(mktemp)"
  ADMIN_RC=1 ADMIN_OUT="" ADMIN_ERR=""
  ANSIBLE_NOCOLOR=1 ansible-playbook admins.yml -e "out=$out" "$@" >"$log" 2>&1 || true
  if [ -s "$out" ]; then
    field='import json,sys; print(json.load(open(sys.argv[1]))[sys.argv[2]])'
    ADMIN_RC="$(python3 -c "$field" "$out" rc)"
    ADMIN_OUT="$(python3 -c "$field" "$out" stdout)"
    # Django prefixes a refusal with "CommandError: "; the sentence after it is
    # the part worth showing.
    ADMIN_ERR="$(python3 -c "$field" "$out" stderr | grep -v '^$' | tail -n 1 | sed 's/^CommandError: //')"
  else
    # The command never ran: corliss has no CTID, is unreachable, or the
    # request was refused before it got there.
    ADMIN_ERR="$(grep -a -E 'Action failed:|UNREACHABLE|ERROR' "$log" | tail -n 3 \
      | sed 's/.*Action failed: //')"
    [ -n "$ADMIN_ERR" ] || ADMIN_ERR="$(tail -n 6 "$log")"
  fi
  rm -f "$out" "$log"
  [ "$ADMIN_RC" = 0 ]
}

# load_admins — the current admins into ADM_*, and anything the operator should
# know about the roster or the service session into ADM_NOTE.
load_admins() {
  local kind a b c
  ADM_DID=() ADM_HANDLE=() ADM_MEMBER=() ADM_NOTE=""
  admins_run -e admin_action=show || return 1
  while IFS=$'\t' read -r kind a b c; do
    case "$kind" in
      admin) ADM_DID+=("$a") ADM_HANDLE+=("$b") ADM_MEMBER+=("$c") ;;
      note) ADM_NOTE="${ADM_NOTE:+$ADM_NOTE
}$a" ;;
    esac
  done < <(python3 -c '
import json, sys
report = json.loads(sys.argv[1])
for a in report["admins"]:
    print("admin", a["did"], a["handle"], "yes" if a["member"] else "no", sep="\t")
if not report["roster_exists"]:
    print("note\tNo roster has been written yet: the service account is the only admin.")
service = report.get("service", {})
if not service.get("configured"):
    print("note\tNo service DID is recorded: set one under Cluster Settings.")
elif not service.get("present"):
    print("note\tThe service account is not signed in to Corliss, so admins cannot be changed until it is.")
elif not service.get("can_write_registry"):
    print("note\tThe service account has no registry session: sign in to Corliss as it again.")
' "$ADMIN_OUT")
}

admins_table() {
  local i
  if [ "${#ADM_DID[@]}" -eq 0 ]; then
    echo "  (none)"
    return 0
  fi
  # 72 columns with a did:plc, inside the 74 a full-width dialog has for text:
  # a wider row wraps in whiptail and breaks the table.
  printf '  %-30s %-6s %s\n' "Handle" "Member" "DID"
  printf '  %-30s %-6s %s\n' "------------------------------" "------" "--------------------------------"
  for i in "${!ADM_DID[@]}"; do
    printf '  %-30s %-6s %s\n' "${ADM_HANDLE[$i]}" \
      "$([ "${ADM_MEMBER[$i]}" = yes ] && echo Yes || echo No)" "${ADM_DID[$i]}"
  done
}

# normalise_who <input> — echo a handle or DID in the form admins.yml accepts,
# or fail.
normalise_who() {
  local who="${1#@}"
  [[ "$who" == did:* ]] || who="$(tr '[:upper:]' '[:lower:]' <<<"$who")"
  [[ "$who" =~ $HANDLE_RE || "$who" =~ $DID_RE ]] || return 1
  echo "$who"
}

# After a change that the PDS reads at provision time, say how to apply it.
pds_hint() {
  local i
  load_state
  i="$(index_of pds)" && [ -n "${SVC_CTID[$i]}" ] \
    && echo "The PDS picks this up on: scn-config nonint apply-admins"
  return 0
}

# Everything that keeps its own copy of the admin list, in the order it is
# applied. An add or remove reaches Corliss as it happens, and nothing else; a
# service built or restored since then has never been told. Applying changes no
# admins, it gives the roster as it stands to each of these. A new consumer is
# a name here, a label below, and a branch in the two apply functions.
ADMIN_TARGETS=(corliss pds)

admin_target_label() {
  case "$1" in
    corliss) echo "Who its console and Django admin treat as admins" ;;
    pds) echo "Who may administer it (provisions pds)" ;;
  esac
}

# pds_assigned — true when the PDS has a container to apply anything to.
pds_assigned() {
  local i
  load_state
  i="$(index_of pds)" && [ -n "${SVC_CTID[$i]}" ]
}

# Corliss re-derives its is_staff flags from the roster (sync_admins, v1.3.2).
# Result in ADMIN_RC / ADMIN_OUT / ADMIN_ERR, like every other admins.yml run.
apply_admins_corliss() {
  admins_run -e admin_action=apply && return 0
  # Django's last word on a missing command is a usage hint, which says nothing
  # about the fix.
  if [[ "$ADMIN_ERR" == *"Unknown command"* || "$ADMIN_ERR" == *"manage.py help"* ]]; then
    ADMIN_ERR="Corliss here is older than v1.3.2, which added this. Provision corliss first."
  fi
  return 1
}

nonint_apply_admins() {
  local target targets=("$@") failed=0
  [ $# -gt 0 ] || targets=("${ADMIN_TARGETS[@]}")
  for target in "${targets[@]}"; do
    [[ " ${ADMIN_TARGETS[*]} " == *" $target "* ]] \
      || die "'$target' is not somewhere admins are applied (${ADMIN_TARGETS[*]})"
  done
  for target in "${targets[@]}"; do
    case "$target" in
      corliss)
        if apply_admins_corliss; then
          echo "$ADMIN_OUT"
        else
          echo "scn-config: Corliss was not updated: $ADMIN_ERR" >&2
          failed=1
        fi
        ;;
      pds)
        if pds_assigned; then
          ansible-playbook provision.yml --limit pds || failed=1
        else
          echo "The PDS has no container ID yet; it reads the roster when it is first provisioned."
        fi
        ;;
    esac
  done
  [ "$failed" = 0 ]
}

nonint_show_admins() {
  load_admins || die "could not read the admins: $ADMIN_ERR"
  admins_table
  [ -z "$ADM_NOTE" ] || printf '\n%s\n' "$ADM_NOTE"
}

nonint_add_admin() {
  local who args=()
  [ $# -ge 1 ] || usage
  who="$(normalise_who "$1")" || die "'$1' is not a handle or a DID"
  shift
  while [ $# -gt 0 ]; do
    case "$1" in
      --admit) args+=(-e admit=true) ;;
      --tier) [ $# -ge 2 ] || usage; args+=(-e "tier=$2"); shift ;;
      *) usage ;;
    esac
    shift
  done
  admins_run -e admin_action=add -e "who=$who" ${args[@]+"${args[@]}"} \
    || die "$who was not made an admin: $ADMIN_ERR"
  echo "$ADMIN_OUT"
  pds_hint
}

nonint_remove_admin() {
  local who
  [ $# -eq 1 ] || usage
  who="$(normalise_who "$1")" || die "'$1' is not a handle or a DID"
  admins_run -e admin_action=remove -e "who=$who" \
    || die "$who was not removed: $ADMIN_ERR"
  echo "$ADMIN_OUT"
  pds_hint
}

# --- Mail relay ---------------------------------------------------------------
# What set-smtp.yml reports about the stored relay: never the credentials.
SMTP_STATE=unset SMTP_SCHEME="" SMTP_HOST="" SMTP_PORT="" SMTP_TLS=""

load_smtp() {
  local out key value
  SMTP_STATE=unset SMTP_SCHEME="" SMTP_HOST="" SMTP_PORT="" SMTP_TLS="" ALERT_EMAIL=""
  out="$(mktemp)"
  if ! ANSIBLE_NOCOLOR=1 ansible-playbook set-smtp.yml -e smtp_action=show \
      -e "out=$out" >/dev/null 2>&1; then
    rm -f "$out"
    die "could not read the mail relay — run: ansible-playbook set-smtp.yml -e smtp_action=show"
  fi
  while read -r key value; do
    case "$key" in
      state) SMTP_STATE="$value" ;;
      scheme) SMTP_SCHEME="$value" ;;
      host) SMTP_HOST="$value" ;;
      port) SMTP_PORT="$value" ;;
      tls) SMTP_TLS="$value" ;;
      alert_email) [ "$value" = - ] || ALERT_EMAIL="$value" ;;
    esac
  done <"$out"
  rm -f "$out"
}

# tls_label <implicit|starttls|none> — how to say it to a person.
tls_label() {
  case "$1" in
    implicit) echo "implicit TLS" ;;
    starttls) echo "STARTTLS" ;;
    *) echo "NOT ENCRYPTED" ;;
  esac
}

smtp_summary() {
  if [ "$SMTP_STATE" = set ]; then
    echo "$SMTP_SCHEME://$SMTP_HOST:$SMTP_PORT ($(tls_label "$SMTP_TLS"))"
  else
    echo "not set — mail is off"
  fi
}

# set_smtp <url> [ansible args] — the URL goes in the environment, never an
# argument: arguments are on the process list for as long as the play runs.
set_smtp() {
  local url="$1"; shift
  SCN_SMTP_URL="$url" ansible-playbook set-smtp.yml -e smtp_action=set "$@"
}

# Where the monitoring hub mails its alerts. Alerts need this and the relay.
alert_summary() {
  if [ -n "$ALERT_EMAIL" ] && [ "$SMTP_STATE" = set ]; then
    echo "$ALERT_EMAIL"
  elif [ -n "$ALERT_EMAIL" ]; then
    echo "$ALERT_EMAIL (no relay, so alerts are off)"
  else
    echo "not set, so alerts are off"
  fi
}

nonint_show_smtp() {
  load_smtp
  echo "mail relay: $(smtp_summary)"
  echo "alert recipient: $(alert_summary)"
}

nonint_set_alert_email() {
  [ $# -eq 1 ] || die "usage: scn-config nonint set-alert-email <address>"
  ansible-playbook set-smtp.yml -e smtp_action=set-alert-email -e "alert_email=$1"
}

nonint_clear_alert_email() {
  ansible-playbook set-smtp.yml -e smtp_action=clear-alert-email
}

# The URL comes from stdin so the password stays out of shell history and the
# process list. Typed at a terminal, it is not echoed.
nonint_set_smtp() {
  local url=""
  if [ -t 0 ]; then
    read -r -s -p "SMTP URL (input hidden): " url || true
    echo
  else
    read -r url || true
  fi
  [ -n "$url" ] || die "no URL on stdin, e.g. smtps://user:password@smtp.example.com:465"
  set_smtp "$url"
}

nonint_clear_smtp() {
  ansible-playbook set-smtp.yml -e smtp_action=clear
}

# --- scn-chat admin key -------------------------------------------------------
# What set-scn-chat-key.yml reports: set or unset, never the key.
SCN_CHAT_KEY_STATE=unset

load_scn_chat_key() {
  local out key value
  SCN_CHAT_KEY_STATE=unset
  out="$(mktemp)"
  if ! ANSIBLE_NOCOLOR=1 ansible-playbook set-scn-chat-key.yml -e key_action=show \
      -e "out=$out" >/dev/null 2>&1; then
    rm -f "$out"
    die "could not read the scn-chat admin key. Run: ansible-playbook set-scn-chat-key.yml -e key_action=show"
  fi
  while read -r key value; do
    [ "$key" = state ] && SCN_CHAT_KEY_STATE="$value"
  done <"$out"
  rm -f "$out"
}

scn_chat_key_summary() {
  if [ "$SCN_CHAT_KEY_STATE" = set ]; then
    echo "set, cron runs every 5 minutes"
  else
    echo "not set, cron is off"
  fi
}

# set_scn_chat_key <key>: the key goes in the environment, never an argument, like set_smtp.
set_scn_chat_key() {
  SCN_CHAT_ADMIN_KEY="$1" ansible-playbook set-scn-chat-key.yml -e key_action=set
}

nonint_show_scn_chat_key() {
  load_scn_chat_key
  echo "scn-chat admin key: $(scn_chat_key_summary)"
}

# The key comes from stdin so it stays out of shell history and the process
# list. Typed at a terminal, it is not echoed.
nonint_set_scn_chat_key() {
  local key=""
  if [ -t 0 ]; then
    read -r -s -p "scn-chat admin key (input hidden): " key || true
    echo
  else
    read -r key || true
  fi
  [ -n "$key" ] || die "no key on stdin. Mint one in scn-chat's Admin > API keys, holding admin"
  set_scn_chat_key "$key"
}

nonint_clear_scn_chat_key() {
  ansible-playbook set-scn-chat-key.yml -e key_action=clear
}

# --- Signing keys -------------------------------------------------------------
# What rotate-key.yml reports: one row per key in signing_key_registry. Never
# the keys themselves.
KEY_NAME=() KEY_SERVICE=() KEY_STATE=() KEY_RETIRE=()

load_keys() {
  local out name service state retire
  KEY_NAME=() KEY_SERVICE=() KEY_STATE=() KEY_RETIRE=()
  out="$(mktemp)"
  if ! ANSIBLE_NOCOLOR=1 ansible-playbook rotate-key.yml -e key_action=show \
      -e "out=$out" >/dev/null 2>&1; then
    rm -f "$out"
    die "could not read the signing keys; run: ansible-playbook rotate-key.yml -e key_action=show"
  fi
  while IFS='|' read -r name service state retire; do
    [ -n "$name" ] || continue
    KEY_NAME+=("$name") KEY_SERVICE+=("$service")
    KEY_STATE+=("$state") KEY_RETIRE+=("$retire")
  done <"$out"
  rm -f "$out"
}

nonint_show_keys() {
  local i
  load_keys
  for i in "${!KEY_NAME[@]}"; do
    printf '%-22s %-10s %s\n' "${KEY_NAME[$i]}" "${KEY_SERVICE[$i]}" "${KEY_STATE[$i]}"
  done
}

nonint_rotate_key() {
  [ $# -eq 1 ] || usage
  ansible-playbook rotate-key.yml -e key_action=rotate -e "key=$1"
}

nonint_retire_key() {
  [ $# -eq 1 ] || usage
  ansible-playbook rotate-key.yml -e key_action=retire -e "key=$1"
}

# --- Release versions ---------------------------------------------------------
# What set-version.yml reports: one row per service. VER_SETTABLE is yes for an
# app cloned at a tag (scn-chat, corliss), whose version a cluster records;
# the rest show their deployed version only. "-" means nothing to show.
VER_NAME=() VER_SETTABLE=() VER_SET=() VER_DEFAULT=() VER_LATEST=() VER_DEPLOYED=()

load_versions() {
  local out name settable set default latest deployed
  VER_NAME=() VER_SETTABLE=() VER_SET=() VER_DEFAULT=() VER_LATEST=() VER_DEPLOYED=()
  out="$(mktemp)"
  if ! ANSIBLE_NOCOLOR=1 ansible-playbook set-version.yml -e version_action=show \
      -e "out=$out" >/dev/null 2>&1; then
    rm -f "$out"
    die "could not read the versions; run: ansible-playbook set-version.yml -e version_action=show"
  fi
  while IFS='|' read -r name settable set default latest deployed; do
    [ -n "$name" ] || continue
    VER_NAME+=("$name") VER_SETTABLE+=("$settable") VER_SET+=("$set")
    VER_DEFAULT+=("$default") VER_LATEST+=("$latest") VER_DEPLOYED+=("$deployed")
  done <"$out"
  rm -f "$out"
}

# version_setting <index>: what the app deploys, "latest" or "v0.2.2": the
# recorded value, else the role default. Which of the two it is matters only
# when changing it, and the Versions menu says so there ("Back to the role
# default").
version_setting() {
  if [ "${VER_SET[$1]}" != - ]; then
    echo "${VER_SET[$1]}"
  else
    echo "${VER_DEFAULT[$1]}"
  fi
}

versions_table() {
  local i
  # Deployed goes last: a package version (5:8.0.2-3+deb13u2) runs long, and a
  # ragged last column misaligns nothing.
  printf '  %-14s %-18s %-12s %s\n' "Service" "Set to" "Latest" "Deployed"
  printf '  %-14s %-18s %-12s %s\n' "-------" "------" "------" "--------"
  for i in "${!VER_NAME[@]}"; do
    if [ "${VER_SETTABLE[$i]}" = yes ]; then
      printf '  %-14s %-18s %-12s %s\n' "${VER_NAME[$i]}" "$(version_setting "$i")" \
        "${VER_LATEST[$i]}" "${VER_DEPLOYED[$i]}"
    else
      # Not settable: the role's own pin, "-" for one that pins nothing.
      printf '  %-14s %-18s %-12s %s\n' "${VER_NAME[$i]}" "${VER_DEFAULT[$i]}" "" "${VER_DEPLOYED[$i]}"
    fi
  done
}

nonint_show_versions() {
  load_versions
  versions_table
}

nonint_set_version() {
  [ $# -eq 2 ] || usage
  ansible-playbook set-version.yml -e version_action=set -e "app=$1" -e "version=$2"
}

nonint_clear_version() {
  [ $# -eq 1 ] || usage
  ansible-playbook set-version.yml -e version_action=clear -e "app=$1"
}

do_versions_menu() {
  local args=() i choice text action version out
  # TERM=ansi: see the infobox in do_assign_menu.
  TERM=ansi whiptail --backtitle "$BACKTITLE" --title "Versions" \
    --infobox "Reading the versions…" 8 "$WT_WIDTH"
  load_versions
  for i in "${!VER_NAME[@]}"; do
    [ "${VER_SETTABLE[$i]}" = yes ] || continue
    args+=("${VER_NAME[$i]}" " $(version_setting "$i"), latest ${VER_LATEST[$i]}")
  done
  text="$(versions_table)

Pick an app to set the release it deploys: a tag, or latest, which is
the newest release each time it is provisioned."
  choice="$(whiptail --backtitle "$BACKTITLE" --title "Versions" \
    --ok-button Select --cancel-button Back \
    --menu "$text" "$(box_height "$text" $(( ${#args[@]} / 2 + 8 )))" \
    "$WT_WIDTH" $(( ${#args[@]} / 2 )) "${args[@]}" 3>&1 1>&2 2>&3)" || return 0

  for i in "${!VER_NAME[@]}"; do [ "${VER_NAME[$i]}" = "$choice" ] && break; done
  action="$(whiptail --backtitle "$BACKTITLE" --title "Versions" \
    --ok-button Select --cancel-button Back \
    --menu "$choice is set to $(version_setting "$i")." 12 "$WT_WIDTH" 3 \
    "latest" " The newest release, ${VER_LATEST[$i]} today" \
    "tag" " Pin a release tag" \
    "default" " Back to the role default, ${VER_DEFAULT[$i]}" \
    3>&1 1>&2 2>&3)" || return 0
  case "$action" in
    latest) version=latest ;;
    tag)
      version="$(ask "Versions" "The release tag for $choice, e.g. ${VER_LATEST[$i]}" \
        "${VER_DEPLOYED[$i]#-}")" || return 0
      ;;
  esac
  if [ "$action" = default ]; then
    out="$(ANSIBLE_NOCOLOR=1 nonint_clear_version "$choice" 2>&1)"
  else
    out="$(ANSIBLE_NOCOLOR=1 nonint_set_version "$choice" "$version" 2>&1)"
  fi || {
    msgbox "Versions" "Could not set $choice.

$(tail -n 12 <<<"$out")"
    return 0
  }
  load_versions
  for i in "${!VER_NAME[@]}"; do [ "${VER_NAME[$i]}" = "$choice" ] && break; done
  offer_provision "$choice" "Versions" "$choice is set to $(version_setting "$i")."
}

do_keys_menu() {
  local args=() i choice text action out
  # TERM=ansi: see the infobox in do_assign_menu.
  TERM=ansi whiptail --backtitle "$BACKTITLE" --title "Signing Keys" \
    --infobox "Reading the signing keys…" 8 "$WT_WIDTH"
  load_keys
  for i in "${!KEY_NAME[@]}"; do
    args+=("${KEY_NAME[$i]}" " ${KEY_SERVICE[$i]}, ${KEY_STATE[$i]}")
  done
  text="The keys services sign OAuth tokens with. Rotating puts a new key in
front and keeps the old one working; retiring removes the old one."
  choice="$(whiptail --backtitle "$BACKTITLE" --title "Signing Keys" \
    --ok-button Select --cancel-button Back \
    --menu "$text" "$(box_height "$text" $(( ${#KEY_NAME[@]} + 8 )))" \
    "$WT_WIDTH" "${#KEY_NAME[@]}" "${args[@]}" 3>&1 1>&2 2>&3)" || return 0

  for i in "${!KEY_NAME[@]}"; do [ "${KEY_NAME[$i]}" = "$choice" ] && break; done
  if [ "${KEY_STATE[$i]}" = current ]; then
    action=rotate
    text="Rotate $choice?

${KEY_SERVICE[$i]} will sign with a new key and keep the old one working
until you retire it. Retiring later: ${KEY_RETIRE[$i]}"
  else
    action=retire
    text="Retire the previous $choice key (${KEY_STATE[$i]})?

${KEY_RETIRE[$i]}"
  fi
  whiptail --backtitle "$BACKTITLE" --title "Signing Keys" \
    --yes-button "${action^}" --no-button Back \
    --yesno "$text" "$(box_height "$text" 7)" "$WT_WIDTH" || return 0
  if out="$(ANSIBLE_NOCOLOR=1 "nonint_${action}_key" "$choice" 2>&1)"; then
    offer_provision "${KEY_SERVICE[$i]}" "Signing Keys" "$choice: ${action}d."
  else
    msgbox "Signing Keys" "Could not $action $choice.

$(tail -n 12 <<<"$out")"
  fi
}

# --- Monitoring agents ---------------------------------------------------------
# The Beszel agent on the control node and every service container
# (monitor-agent.yml, zai-ops#3). Only "go": the version is the committed
# beszel_version, never set here.

beszel_version() {
  awk '$1=="beszel_version:"{gsub(/"/, "", $2); print $2}' group_vars/all/main.yml
}

nonint_apply_monitor_agents() {
  if [ $# -gt 0 ]; then
    local IFS=,
    ansible-playbook monitor-agent.yml --limit "$*"
  else
    ansible-playbook monitor-agent.yml
  fi
}

# print-monitor-agent-install <machine>: a root script that installs the agent
# on a machine Ansible doesn't manage (an inference node), on stdout. It holds
# the agent token, so it is written 0600, printed, and removed.
nonint_print_monitor_agent_install() {
  [ $# -eq 1 ] || die "usage: scn-config nonint print-monitor-agent-install <machine>"
  local out log
  out="$(mktemp)" log="$(mktemp)"
  if ! ansible-playbook monitor-agent-install.yml -e "machine=$1" -e "out=$out" >"$log" 2>&1; then
    cat "$log" >&2
    rm -f "$out" "$log"
    die "could not write the install script for $1"
  fi
  cat "$out"
  rm -f "$out" "$log"
}

# Leaves whiptail for the run, like run_provision: the playbook output is the
# report.
do_monitor_agents_menu() {
  local text failed=""
  text="Install or update the Beszel monitoring agent on the control node and
every provisioned service container, at Beszel $(beszel_version).

A container is skipped while the hub is not provisioned or not answering."
  whiptail --backtitle "$BACKTITLE" --title "Monitoring Agents" \
    --yes-button Install --no-button Back \
    --yesno "$text" "$(box_height "$text" 7)" "$WT_WIDTH" || return 0
  clear
  nonint_apply_monitor_agents </dev/null || failed=1
  echo
  if [ -n "$failed" ]; then
    echo "scn-config: a monitoring agent FAILED; see the output above."
  else
    echo "scn-config: the monitoring agents are installed."
  fi
  read -r -p "Press Enter to return to the menu. " </dev/tty || true
}

# --- Interactive mode --------------------------------------------------------
calc_wt_size() {
  WT_WIDTH="$(tput cols 2>/dev/null || echo 80)"
  WT_MAX_HEIGHT=$(( $(tput lines 2>/dev/null || echo 24) - 2 ))
  [ "$WT_WIDTH" -gt 78 ] && WT_WIDTH=78
  return 0
}

# box_height <text> <chrome> — a dialog tall enough for the text plus its
# borders, buttons and any list (the chrome), capped to the terminal.
box_height() {
  local height=$(( $(wc -l <<<"$1") + $2 ))
  [ "$height" -gt "$WT_MAX_HEIGHT" ] && height="$WT_MAX_HEIGHT"
  echo "$height"
}

msgbox() {  # msgbox <title> <text>
  whiptail --backtitle "$BACKTITLE" --title "$1" \
    --msgbox "$2" "$(box_height "$2" 7)" "$WT_WIDTH"
}

# ctid_label <ctid> — "CTID: 102  IP: 10.1.1.102". The address is derived from
# the CTID, so every screen that shows one shows the other.
ctid_label() { echo "CTID: $1  IP: 10.1.1.$1"; }

# whiptail has no table widget, so tables are fixed-width text: a header, a
# rule, then one table_row per service.
table_header() {
  printf '  %-14s %-6s %s\n' "Service" "CTID" "IP Address"
  printf '  %-14s %-6s %s\n' "--------------" "----" "----------"
}

table_row() {  # table_row <service> <ctid, or "" when not set yet>
  if [ -n "$2" ]; then
    printf '  %-14s %-6s %s\n' "$1" "$2" "10.1.1.$2"
  else
    printf '  %-14s %s\n' "$1" "(not set)"
  fi
}

# The recorded assignments, as a table for dialog text.
assigned_table() {
  local i
  table_header
  for i in "${!SVC_NAME[@]}"; do
    [ -n "${SVC_CTID[$i]}" ] && table_row "${SVC_NAME[$i]}" "${SVC_CTID[$i]}"
  done
  return 0
}

pending_table() {
  local i
  table_header
  for i in "${!P_NAME[@]}"; do
    table_row "${P_NAME[$i]}" "${P_CTID[$i]}"
  done
}

# Fails when two pending services hold the same CTID, echoing which.
pending_duplicate() {
  local i j
  for i in "${!P_NAME[@]}"; do
    for j in "${!P_NAME[@]}"; do
      if [ "$i" -lt "$j" ] && [ "${P_CTID[$i]}" = "${P_CTID[$j]}" ]; then
        echo "${P_NAME[$i]} and ${P_NAME[$j]} are both set to ${P_CTID[$i]}."
        return 1
      fi
    done
  done
}

pending_has_unset() {
  local i
  for i in "${!P_NAME[@]}"; do
    [ -z "${P_CTID[$i]}" ] && return 0
  done
  return 1
}

# Walk an input box per pending service. Fails if the operator cancels.
edit_pending() {
  local i value problem
  for i in "${!P_NAME[@]}"; do
    value="${P_CTID[$i]}"
    while true; do
      value="$(whiptail --backtitle "$BACKTITLE" --title "Container Assignment" \
        --inputbox "Container ID for ${P_NAME[$i]} (100-999).\n\nIts address becomes 10.1.1.<ctid>." \
        10 "$WT_WIDTH" "$value" 3>&1 1>&2 2>&3)" || return 1
      problem="$(ctid_problem "$value")"
      [ -z "$problem" ] && break
      msgbox "Container Assignment" "${P_NAME[$i]}: $problem."
    done
    P_CTID[i]="$((10#$value))"   # 10#: a leading zero is not octal
  done
}

do_setup_menu() {
  local text
  text="This runs, in order:

  site.yml             Configure this control node
  verify-proxmox.yml   Check that the Proxmox API token authenticates

It is the first thing to do on a new cluster, and safe to run again."
  whiptail --backtitle "$BACKTITLE" --title "Control Node Setup" \
    --yes-button Run --no-button Back \
    --yesno "$text" "$(box_height "$text" 7)" "$WT_WIDTH" || return 0
  # Leaves whiptail for the run, like run_provision: the playbook output is the
  # progress display.
  clear
  run_setup || true
  read -r -p "Press Enter to return to the menu. " </dev/tty || true
}

settings_domain() {
  local domain text out
  load_state
  domain="$CLUSTER_DOMAIN"
  while true; do
    domain="$(ask "Cluster Settings" "The cluster's public base domain, e.g. example.com

Every public address is built from it: the membership site on the
domain itself, and owui.<domain>, api.<domain> and the rest beside it." "$domain")" || return 0
    domain="$(tr '[:upper:]' '[:lower:]' <<<"$domain")"
    # A handle and a domain have the same shape.
    [[ "$domain" =~ $HANDLE_RE ]] && break
    msgbox "Cluster Settings" "That is not a domain. Enter it bare, like example.com: no
https://, no path, no spaces."
  done
  if [ "$domain" = "$CLUSTER_DOMAIN" ]; then
    msgbox "Cluster Settings" "The domain is already $domain."
    return 0
  fi

  if [ -n "$CLUSTER_DOMAIN" ]; then
    # Every service renders its own and its neighbours' public URLs when it is
    # provisioned, so a changed domain reaches none of them until then.
    text="Change the cluster's domain?

  from  $CLUSTER_DOMAIN
  to    $domain

Nothing running changes yet. Every service that is already provisioned
keeps the old addresses until it is provisioned again."
  else
    text="Set the cluster's domain to $domain?"
  fi
  whiptail --backtitle "$BACKTITLE" --title "Cluster Settings" \
    --yes-button Save --no-button Back \
    --yesno "$text" "$(box_height "$text" 7)" "$WT_WIDTH" || return 0

  # TERM=ansi: see the infobox in do_assign_menu.
  TERM=ansi whiptail --backtitle "$BACKTITLE" --title "Cluster Settings" \
    --infobox "Recording the domain…" 8 "$WT_WIDTH"
  if out="$(ANSIBLE_NOCOLOR=1 set_domain "$domain" 2>&1)"; then
    if [ -n "$CLUSTER_DOMAIN" ]; then
      msgbox "Cluster Settings" "The domain is now $domain.

Provision every service again, under Provision Containers, to move
them to it."
    else
      msgbox "Cluster Settings" "The domain is now $domain."
    fi
  else
    msgbox "Cluster Settings" "The domain was refused — nothing was written.

$(playbook_problem "$out")"
  fi
}

# Where member handles go. Blank means the cluster domain, the usual case; a
# domain of their own keeps a handle from competing with a service hostname.
settings_handle_domain() {
  local domain="$HANDLE_DOMAIN" allow=true picked text saved out
  while true; do
    domain="$(ask "Cluster Settings" "The domain member handles are issued under, e.g. example.net.

Leave empty to use the cluster domain, ${CLUSTER_DOMAIN:-once it is set}." "$domain")" || return 0
    domain="$(tr '[:upper:]' '[:lower:]' <<<"$domain")"
    [ -z "$domain" ] || [[ "$domain" =~ $HANDLE_RE ]] && break
    msgbox "Cluster Settings" "That is not a domain. Enter it bare, like example.net: no
https://, no path, no spaces."
  done
  [ "$domain" = "$CLUSTER_DOMAIN" ] && domain=""

  if [ -n "$domain" ]; then
    picked="$(whiptail --backtitle "$BACKTITLE" --title "Cluster Settings" \
      --ok-button Next --cancel-button Back \
      --checklist "Handles at $domain. (space toggles)" 9 "$WT_WIDTH" 1 \
      allow " Allow handles at the cluster domain too" \
      "$([ "$HANDLE_ALLOW_CLUSTER" = false ] && echo OFF || echo ON)" \
      3>&1 1>&2 2>&3)" || return 0
    [[ "$picked" == *allow* ]] || allow=false
  fi
  if [ "$domain" = "$HANDLE_DOMAIN" ] && { [ -z "$domain" ] || [ "$allow" = "$HANDLE_ALLOW_CLUSTER" ]; }; then
    msgbox "Cluster Settings" "That is already what is recorded."
    return 0
  fi

  if [ -n "$domain" ]; then
    text="Issue member handles under $domain?" saved="Handles now go under $domain."
  else
    text="Issue member handles under the cluster domain again?"
    saved="Handles now go under the cluster domain."
  fi
  whiptail --backtitle "$BACKTITLE" --title "Cluster Settings" \
    --yes-button Save --no-button Back \
    --yesno "$text" "$(box_height "$text" 7)" "$WT_WIDTH" || return 0

  # TERM=ansi: see the infobox in do_assign_menu.
  TERM=ansi whiptail --backtitle "$BACKTITLE" --title "Cluster Settings" \
    --infobox "Recording the handle domain…" 8 "$WT_WIDTH"
  if out="$(ANSIBLE_NOCOLOR=1 set_handle_domain "$domain" "$allow" 2>&1)"; then
    offer_provision pds "Cluster Settings" "$saved"
  else
    msgbox "Cluster Settings" "The handle domain was refused. Nothing was written.

$(playbook_problem "$out")"
  fi
}

# The Domains row: the cluster domain, and where handles go, which follows it
# unless split off.
settings_domains() {
  local choice text
  while true; do
    load_state
    text="The cluster's domains. Select one to change it."
    choice="$(whiptail --backtitle "$BACKTITLE" --title "Cluster Settings" \
      --ok-button Select --cancel-button Back \
      --menu "$text" "$(box_height "$text" 10)" "$WT_WIDTH" 2 \
      "Cluster domain" " ${CLUSTER_DOMAIN:-not set}" \
      "Handle domain" " $(handle_domain_summary)" \
      3>&1 1>&2 2>&3)" || return 0
    case "$choice" in
      "Cluster domain") settings_domain ;;
      "Handle domain") settings_handle_domain ;;
    esac
  done
}

# settings_registry <client_key|service_did> — one of the two values that say
# which membership registry this cluster belongs to.
settings_registry() {
  local key="$1" label current value prompt text saved out
  case "$key" in
    service_did)
      label="service DID" current="$REGISTRY_SERVICE_DID"
      prompt="The DID of the account whose repo holds the cluster's public admin
roster, e.g. did:plc:…

Corliss and the PDS read who the admins are through it. Leave empty to
record none: the roster then reads as empty."
      ;;
    client_key)
      label="client key" current="$REGISTRY_CLIENT_KEY"
      prompt="The membership registry's public HappyView client key, e.g. hvc_…

Corliss sends it with its registry reads. Optional: the cluster works
without one. Leave empty to record none."
      ;;
  esac
  value="$current"
  while true; do
    value="$(ask "Cluster Settings" "$prompt" "$value")" || return 0
    if [[ "$value" =~ [[:space:]] ]]; then
      msgbox "Cluster Settings" "The $label cannot contain spaces."
    elif [ "$key" = service_did ] && [ -n "$value" ] && ! [[ "$value" =~ $DID_RE ]]; then
      msgbox "Cluster Settings" "That is not a DID. It starts did:plc: or did:web:"
    else
      break
    fi
  done
  if [ "$value" = "$current" ]; then
    msgbox "Cluster Settings" "That is already what is recorded."
    return 0
  fi

  if [ -n "$value" ]; then
    text="Set the registry $label to:

  $value" saved="The registry $label is saved."
  else
    text="Remove the recorded registry $label?" saved="The registry $label is removed."
  fi
  # The PDS takes its admins from the same roster, each time it is provisioned.
  [ "$key" = service_did ] && saved="$saved

The PDS reads the roster through it too, on its own next provision."
  whiptail --backtitle "$BACKTITLE" --title "Cluster Settings" \
    --yes-button Save --no-button Back \
    --yesno "$text" "$(box_height "$text" 7)" "$WT_WIDTH" || return 0

  # TERM=ansi: see the infobox in do_assign_menu.
  TERM=ansi whiptail --backtitle "$BACKTITLE" --title "Cluster Settings" \
    --infobox "Recording the registry $label…" 8 "$WT_WIDTH"
  if out="$(ANSIBLE_NOCOLOR=1 set_registry "$key" "$value" 2>&1)"; then
    offer_provision corliss "Cluster Settings" "$saved"
  else
    msgbox "Cluster Settings" "The registry $label was refused. Nothing was written.

$(playbook_problem "$out")"
  fi
}

# Bootstrap records the host's name from the host itself, so this row is only
# ever a correction.
settings_proxmox_host() {
  local name="$PROXMOX_HOST" text out
  while true; do
    name="$(ask "Cluster Settings" "The Proxmox host's own name: what the hostname command prints on it.

Bootstrap records this. Change it only if it is wrong, for example
after the host was renamed." "$name")" || return 0
    [[ "$name" =~ $PROXMOX_HOST_RE ]] && break
    msgbox "Cluster Settings" "That is not a host name. Enter the short name only: letters, digits
and hyphens, no dots."
  done
  if [ "$name" = "$PROXMOX_HOST" ]; then
    msgbox "Cluster Settings" "The Proxmox host name is already $name."
    return 0
  fi

  text="Change the Proxmox host name?

  from  ${PROXMOX_HOST:-(not set)}
  to    $name

Every container is created through the host with this name. If it is
not the host's real name, provisioning times out with HTTP 595."
  whiptail --backtitle "$BACKTITLE" --title "Cluster Settings" \
    --yes-button Save --no-button Back \
    --yesno "$text" "$(box_height "$text" 7)" "$WT_WIDTH" || return 0

  # TERM=ansi: see the infobox in do_assign_menu.
  TERM=ansi whiptail --backtitle "$BACKTITLE" --title "Cluster Settings" \
    --infobox "Recording the Proxmox host name…" 8 "$WT_WIDTH"
  if out="$(ANSIBLE_NOCOLOR=1 set_proxmox_host "$name" 2>&1)"; then
    msgbox "Cluster Settings" "The Proxmox host name is now $name.

Provisioning uses it from the next run."
  else
    msgbox "Cluster Settings" "The name was refused. Nothing was written.

$(playbook_problem "$out")"
  fi
}

# The values that say which cluster this is, one row each with what is
# recorded. Each row is its own playbook; this only lists them. Host name
# first, then domain, the order people expect, though bootstrap has already
# recorded the host name and it rarely needs touching.
do_settings_menu() {
  local choice text
  # TERM=ansi: see the infobox in do_assign_menu.
  TERM=ansi whiptail --backtitle "$BACKTITLE" --title "Cluster Settings" \
    --infobox "Reading the cluster settings…" 8 "$WT_WIDTH"
  load_scn_chat_key
  while true; do
    load_state
    text="What identifies this cluster. Select one to change it."
    choice="$(whiptail --backtitle "$BACKTITLE" --title "Cluster Settings" \
      --ok-button Select --cancel-button Back \
      --menu "$text" "$(box_height "$text" 13)" "$WT_WIDTH" 5 \
      "Proxmox host name" " ${PROXMOX_HOST:-not set}" \
      "Domains" " ${CLUSTER_DOMAIN:-not set}${HANDLE_DOMAIN:+, handles at $HANDLE_DOMAIN}" \
      "Registry service DID" " ${REGISTRY_SERVICE_DID:-not set}" \
      "Registry client key" " ${REGISTRY_CLIENT_KEY:-not set}" \
      "scn-chat admin key" " $(scn_chat_key_summary)" \
      3>&1 1>&2 2>&3)" || return 0
    case "$choice" in
      "Proxmox host name") settings_proxmox_host ;;
      Domains) settings_domains ;;
      "Registry service DID") settings_registry service_did ;;
      "Registry client key") settings_registry client_key ;;
      "scn-chat admin key") settings_scn_chat_key; load_scn_chat_key ;;
    esac
  done
}

# The key scn-chat's cron timer sends. Never pre-filled or shown: the stored
# one is not read back.
settings_scn_chat_key() {
  local choice key text out
  text="scn-chat admin key: $(scn_chat_key_summary)

scn-chat runs its plugins' scheduled work, such as removing revoked
members' scn-member role, only when something calls its cron route.
A timer on the scn-chat container does that with this key."
  choice="$(whiptail --backtitle "$BACKTITLE" --title "Cluster Settings" \
    --ok-button Select --cancel-button Back \
    --menu "$text" "$(box_height "$text" 10)" "$WT_WIDTH" 2 \
    "Set" " Enter a key minted in scn-chat" \
    "Clear" " Remove the key and turn cron off" \
    3>&1 1>&2 2>&3)" || return 0

  if [ "$choice" = Clear ]; then
    [ "$SCN_CHAT_KEY_STATE" = set ] || { msgbox "Cluster Settings" "No scn-chat admin key is set."; return 0; }
    whiptail --backtitle "$BACKTITLE" --title "Cluster Settings" \
      --yes-button Clear --no-button Back \
      --yesno "Remove the scn-chat admin key? scn-chat's cron stops." \
      8 "$WT_WIDTH" || return 0
    if out="$(ANSIBLE_NOCOLOR=1 nonint_clear_scn_chat_key 2>&1)"; then
      offer_provision scn-chat "Cluster Settings" "The scn-chat admin key is cleared."
    else
      msgbox "Cluster Settings" "Could not clear the key.

$(playbook_problem "$out")"
    fi
    return 0
  fi

  while true; do
    key="$(whiptail --backtitle "$BACKTITLE" --title "Cluster Settings" \
      --passwordbox "Mint the key in scn-chat: Admin > API keys, a key holding admin.
Use it only for this, so revoking it stops nothing else.

Paste the key:" 12 "$WT_WIDTH" 3>&1 1>&2 2>&3)" || return 0
    if [ -z "$key" ]; then
      msgbox "Cluster Settings" "No key entered. Choose Clear to remove the key."
    elif [[ "$key" =~ [[:space:]] ]]; then
      msgbox "Cluster Settings" "The key cannot contain spaces."
    else
      break
    fi
  done

  # TERM=ansi: see the infobox in do_assign_menu.
  TERM=ansi whiptail --backtitle "$BACKTITLE" --title "Cluster Settings" \
    --infobox "Recording the scn-chat admin key…" 8 "$WT_WIDTH"
  if out="$(ANSIBLE_NOCOLOR=1 set_scn_chat_key "$key" 2>&1)"; then
    offer_provision scn-chat "Cluster Settings" "The scn-chat admin key is saved."
  else
    msgbox "Cluster Settings" "The key was refused. Nothing was written.

$(playbook_problem "$out")"
  fi
}

do_tls_menu() {
  local mode email="" text out
  load_state
  text="The proxy's certificate: $(proxy_tls_summary)

Caddy gets and renews its own certificates unless you choose otherwise."
  mode="$(whiptail --backtitle "$BACKTITLE" --title "Set TLS" \
    --ok-button Select --cancel-button Back --default-item "${TLS_MODE:-acme}" \
    --menu "$text" "$(box_height "$text" 10)" "$WT_WIDTH" 2 \
    "acme" " (default) Caddy's own Let's Encrypt certificates" \
    "none" " Plain HTTP: another edge in front, or before DNS exists" \
    3>&1 1>&2 2>&3)" || return 0

  if [ "$mode" = acme ]; then
    email="$TLS_EMAIL"
    while true; do
      email="$(ask "Set TLS" "Contact email for the Let's Encrypt account. Optional: leave empty
for none." "$email")" || return 0
      # As loose as set-tls.yml's own check: Let's Encrypt judges the address.
      [ -z "$email" ] || [[ "$email" =~ ^[^@[:space:]]+@[^@[:space:]]+\.[^@[:space:]]+$ ]] && break
      msgbox "Set TLS" "That does not look like an email address."
    done
  fi
  if [ "$mode" = "$TLS_MODE" ] && [ "$email" = "$TLS_EMAIL" ]; then
    msgbox "Set TLS" "That is already what is recorded."
    return 0
  fi

  text="Set the proxy's TLS to:

  $mode — $(proxy_tls_label "$mode")${email:+
  contact $email}"
  case "$mode" in
    acme) text="$text

Public ports 80 and 443 must reach the proxy for certificates to be
issued, and the domain must resolve straight to it." ;;
    none) text="$text

The proxy will serve plain HTTP only." ;;
  esac
  whiptail --backtitle "$BACKTITLE" --title "Set TLS" \
    --yes-button Save --no-button Back \
    --yesno "$text" "$(box_height "$text" 7)" "$WT_WIDTH" || return 0

  # TERM=ansi: see the infobox in do_assign_menu.
  TERM=ansi whiptail --backtitle "$BACKTITLE" --title "Set TLS" \
    --infobox "Recording the TLS mode…" 8 "$WT_WIDTH"
  if out="$(ANSIBLE_NOCOLOR=1 set_tls "$mode" "$email" 2>&1)"; then
    offer_provision proxy "Set TLS" "The TLS mode is saved: $mode."
  else
    msgbox "Set TLS" "The TLS mode was refused — nothing was written.

$(playbook_problem "$out")"
  fi
}

do_assign_menu() {
  local i title intro text default args=() picked name status label out duplicate rc
  local total assigned unassigned
  load_state

  total="${#SVC_NAME[@]}" assigned=0
  for i in "${!SVC_NAME[@]}"; do
    if [ -n "${SVC_CTID[$i]}" ]; then
      assigned=$((assigned + 1))
      continue
    fi
    default="$(usable_default "$i")"
    if [ -n "$default" ]; then
      label="$(ctid_label "$default")" status=ON
    else
      label="(no free default)" status=OFF
    fi
    args+=("${SVC_NAME[$i]}" "$label" "$status")
  done

  unassigned=$((total - assigned))
  if [ "$unassigned" -eq 0 ]; then
    msgbox "Container Assignment" "Every service is assigned:

$(assigned_table)

An assignment is set once and cannot be changed here. To correct one
BEFORE its service has been provisioned:

  scn-config nonint assign-ctid <service> <ctid> --reassign"
    return 0
  fi

  # First run reads differently on purpose: it is the moment the cluster's
  # layout is decided, and there is no undo from this tool.
  if [ "$assigned" -eq 0 ]; then
    title="Initial Container Assignment"
    intro="No service has a container ID yet. This sets them.

Tick the services to assign now; the rest can be done later. An
assignment is permanent once saved — it cannot be changed here."
  else
    title="Container Assignment"
    intro="Already assigned ($assigned of $total) — these are locked:

$(assigned_table)

Tick the services to assign now."
  fi

  picked="$(whiptail --backtitle "$BACKTITLE" --title "$title" --separate-output \
    --ok-button Next --cancel-button Back \
    --checklist "$intro" "$(box_height "$intro" $((unassigned + 8)))" "$WT_WIDTH" "$unassigned" \
    "${args[@]}" 3>&1 1>&2 2>&3)" || return 0
  [ -n "$picked" ] || return 0

  P_NAME=() P_CTID=()
  while read -r name; do
    P_NAME+=("$name")
    P_CTID+=("$(usable_default "$(index_of "$name")")")
  done <<<"$picked"

  # Confirm, with a way back to change the numbers. Esc leaves without writing.
  while true; do
    if pending_has_unset; then
      edit_pending || return 0
    fi
    text="About to assign:

$(pending_table)

This is permanent — an assignment cannot be changed here once saved.
Press Esc to leave without writing anything."
    rc=0
    whiptail --backtitle "$BACKTITLE" --title "$title" \
      --yes-button Assign --no-button "Change numbers" \
      --yesno "$text" "$(box_height "$text" 7)" "$WT_WIDTH" || rc=$?
    case "$rc" in
      0)
        duplicate="$(pending_duplicate)" && break
        msgbox "$title" "$duplicate"
        edit_pending || return 0
        ;;
      1) edit_pending || return 0 ;;
      *) return 0 ;;
    esac
  done

  # TERM=ansi: under xterm, whiptail draws an infobox to the alternate screen
  # and it vanishes the moment whiptail exits, before the playbook has run.
  TERM=ansi whiptail --backtitle "$BACKTITLE" --title "$title" \
    --infobox "Writing assignments…" 8 "$WT_WIDTH"
  if out="$(ANSIBLE_NOCOLOR=1 run_assign 2>&1)"; then
    msgbox "$title" "Assigned:

$(pending_table)

Nothing has been created yet. Next, provision each service:

  ansible-playbook provision.yml --limit <service>"
  else
    msgbox "$title" "The assignment was refused — nothing was written.

$(tail -n 12 <<<"$out")"
  fi
}

# provision_order — echo the indices of the assigned services in the order to
# provision them. That is default_ctid order, not assigned order: the defaults
# follow the tiers (core, platform, apps) and dependencies only point down the
# tiers, so the blueprint's numbering is the dependency order even on a cluster
# that assigned different CTIDs.
provision_order() {
  local i
  for i in "${!SVC_NAME[@]}"; do
    [ -n "${SVC_CTID[$i]}" ] && echo "${SVC_DEFAULT[$i]:-${SVC_CTID[$i]}} $i"
  done | sort -n | cut -d' ' -f2
}

# --- What exists on the node ---
# CT_KNOWN is 1 once the node has been asked; CT_VMID / CT_NAME are its
# containers. Asking needs the API token, so it fails off the control node — the
# provision screen then simply shows no status.
CT_KNOWN=0 CT_VMID=() CT_NAME=()

load_ct_status() {
  local out vmid name
  CT_KNOWN=0 CT_VMID=() CT_NAME=()
  out="$(mktemp)"
  if ANSIBLE_NOCOLOR=1 ansible-playbook ct-status.yml -e "out=$out" >/dev/null 2>&1; then
    CT_KNOWN=1
    while read -r vmid name; do
      [ -n "$vmid" ] && CT_VMID+=("$vmid") && CT_NAME+=("$name")
    done <"$out"
  fi
  rm -f "$out"
}

# ct_status <service> <ctid> — echo "new" (no container at that CTID), "exists"
# (one with this service's name), "taken <name>" (someone else's), or "unknown".
ct_status() {
  local i
  [ "$CT_KNOWN" -eq 1 ] || { echo unknown; return 0; }
  for i in "${!CT_VMID[@]}"; do
    [ "${CT_VMID[$i]}" = "$2" ] || continue
    if [ "${CT_NAME[$i]}" = "$1" ]; then echo exists; else echo "taken ${CT_NAME[$i]}"; fi
    return 0
  done
  echo new
}

do_provision_menu() {
  local i args=() picked text name unassigned=0 note=""
  local status label ticked plan=""
  load_state
  # TERM=ansi: see the infobox in do_assign_menu.
  TERM=ansi whiptail --backtitle "$BACKTITLE" --title "Provision Containers" \
    --infobox "Checking which containers exist…" 8 "$WT_WIDTH"
  load_ct_status

  for i in "${!SVC_NAME[@]}"; do
    [ -z "${SVC_CTID[$i]}" ] && unassigned=$((unassigned + 1))
  done
  for i in $(provision_order); do
    status="$(ct_status "${SVC_NAME[$i]}" "${SVC_CTID[$i]}")"
    label="$(ctid_label "${SVC_CTID[$i]}")" ticked=ON
    case "$status" in
      new) label="$label  action: create" ;;
      exists) label="$label  action: rebuild" ;;
      taken\ *) label="$label  IN USE by ${status#taken }" ticked=OFF ;;
    esac
    args+=("${SVC_NAME[$i]}" "$label" "$ticked")
  done
  if [ "${#args[@]}" -eq 0 ]; then
    msgbox "Provision Containers" "No service has a container ID yet.

Assign them first, under Container Assignment."
    return 0
  fi

  # Services reference each other's addresses (the proxy renders litellm's), so
  # an unassigned one can fail a different service's provision.
  [ "$unassigned" -gt 0 ] && note="

$unassigned service(s) have no CTID yet and are not listed. Provisioning can
fail where a listed service refers to one of them."
  [ "$CT_KNOWN" -eq 1 ] || note="$note

Could not ask Proxmox which containers exist, so none are marked."
  text="Ticked services run in the order shown, which is dependency order.
Rebuilding an existing container is safe.$note"

  picked="$(whiptail --backtitle "$BACKTITLE" --title "Provision Containers" \
    --separate-output --ok-button Next --cancel-button Back \
    --checklist "$text" "$(box_height "$text" $((${#args[@]} / 3 + 8)))" "$WT_WIDTH" \
    "$((${#args[@]} / 3))" "${args[@]}" 3>&1 1>&2 2>&3)" || return 0
  [ -n "$picked" ] || return 0

  # A CTID held by a container that isn't this service's is not ours to build
  # on: provision would try to configure someone else's container.
  while read -r name; do
    i="$(index_of "$name")"
    status="$(ct_status "$name" "${SVC_CTID[$i]}")"
    case "$status" in
      taken\ *)
        msgbox "Provision Containers" "CTID ${SVC_CTID[$i]} is in use by '${status#taken }', which is not $name.

Nothing was run. Untick $name, or free that CTID first."
        return 0
        ;;
      new) plan="$plan$(printf '  %-14s %s' "$name" "create")"$'\n' ;;
      exists) plan="$plan$(printf '  %-14s %s' "$name" "rebuild")"$'\n' ;;
      *) plan="$plan  $name"$'\n' ;;
    esac
  done <<<"$picked"

  text="About to provision, in this order:

${plan%$'\n'}

This can take a while: a service built from source needs 15-30 minutes
on a new container. The run stops at the first failure."
  whiptail --backtitle "$BACKTITLE" --title "Provision Containers" \
    --yes-button Provision --no-button Back \
    --yesno "$text" "$(box_height "$text" 7)" "$WT_WIDTH" || return 0

  # shellcheck disable=SC2086  # service names, one per line, split on purpose
  run_provision $picked
}

# run_provision <service>... — provision each in the order given, stopping at
# the first failure. Leaves whiptail for the run: the playbook output is the
# progress display, and it is what the operator needs on screen if a task fails.
run_provision() {
  local name failed="" remaining=()
  clear
  for name in "$@"; do
    if [ -n "$failed" ]; then
      remaining+=("$name")
      continue
    fi
    printf '\n=== scn-config: provisioning %s ===\n\n' "$name"
    ansible-playbook provision.yml --limit "$name" </dev/null || failed="$name"
  done

  echo
  if [ -n "$failed" ]; then
    echo "scn-config: provisioning $failed FAILED — see the output above."
    [ "${#remaining[@]}" -gt 0 ] && echo "scn-config: not run: ${remaining[*]}"
  else
    echo "scn-config: provisioning finished."
  fi
  read -r -p "Press Enter to return to the menu. " </dev/tty || true
}

# ask <title> <prompt> <default> — an input box; fails if the operator cancels.
ask() {
  whiptail --backtitle "$BACKTITLE" --title "$1" \
    --inputbox "$2" "$(box_height "$2" 8)" "$WT_WIDTH" "$3" 3>&1 1>&2 2>&3
}

# offer_provision <service> <title> <what changed> — for a change a service
# reads only when it is provisioned (the PDS: the mail relay, the admin roster;
# the proxy: the TLS mode; Corliss: the registry identity): offer to do that now, when the service exists to
# provision.
offer_provision() {
  local service="$1" title="$2" i ctid="" text name
  case "$service" in
    pds) name="The PDS" ;;
    corliss) name="Corliss" ;;
    scn-chat) name="scn-chat" ;;
    beszel) name="The monitoring hub" ;;
    *) name="The $service" ;;
  esac
  load_state
  i="$(index_of "$service")" && ctid="${SVC_CTID[$i]}"
  if [ -z "$ctid" ]; then
    msgbox "$title" "$3

$name has no container ID yet, so there is nothing to update there.
It will pick this up when it is first provisioned."
    return 0
  fi
  text="$3

$name picks this up on its next provision. Run that now?"
  whiptail --backtitle "$BACKTITLE" --title "$title" \
    --yes-button "Provision $service" --no-button Later \
    --yesno "$text" "$(box_height "$text" 7)" "$WT_WIDTH" || return 0
  run_provision "$service"
}

# Best-effort lookup so the operator sees who they are about to appoint. Prints
# the DID then the handle. Corliss does the authoritative, verified resolution
# when the appointment is made; this only fills in the confirmation.
IDENTITY_LOOKUP='
import json, sys, urllib.parse, urllib.request
who = sys.argv[1]
def get(url):
    with urllib.request.urlopen(url, timeout=6) as response:
        return response.read().decode()
try:
    if who.startswith("did:plc:"):
        doc = json.loads(get("https://plc.directory/" + who))
    elif who.startswith("did:web:"):
        doc = json.loads(get("https://" + who[8:].split(":")[0] + "/.well-known/did.json"))
    else:
        try:
            did = json.loads(get("https://public.api.bsky.app/xrpc/com.atproto.identity.resolveHandle?handle=" + urllib.parse.quote(who)))["did"]
        except Exception:
            did = get("https://" + who + "/.well-known/atproto-did").strip()
        print(did, who, sep="\n")
        sys.exit(0)
    names = [n[5:] for n in doc.get("alsoKnownAs", []) if n.startswith("at://")]
    print(who, names[0] if names else "", sep="\n")
except Exception:
    sys.exit(1)
'

# admin_change <add|remove> <who> — make the change, offering to admit a
# non-member first, and report what Corliss said.
admin_change() {
  local action="$1" who="$2" tier text
  TERM=ansi whiptail --backtitle "$BACKTITLE" --title "Cluster Admins" \
    --infobox "Asking Corliss…" 8 "$WT_WIDTH"
  if ! admins_run -e "admin_action=$action" -e "who=$who" \
      && [ "$action" = add ] && [[ "$ADMIN_ERR" == *"only a current member"* ]]; then
    # Admins are members. Admitting someone is its own decision, so it is asked,
    # never assumed.
    text="$who is not a member, and only a member can be an admin.

Admit them as a member first, then make them an admin?"
    whiptail --backtitle "$BACKTITLE" --title "Cluster Admins" \
      --yes-button "Admit and appoint" --no-button Back \
      --yesno "$text" "$(box_height "$text" 7)" "$WT_WIDTH" || return 0
    tier="$(ask "Cluster Admins" "Membership tier for $who" "level-0")" || return 0
    TERM=ansi whiptail --backtitle "$BACKTITLE" --title "Cluster Admins" \
      --infobox "Asking Corliss…" 8 "$WT_WIDTH"
    admins_run -e admin_action=add -e "who=$who" -e admit=true -e "tier=$tier" || true
  fi
  if [ "$ADMIN_RC" = 0 ]; then
    offer_provision pds "Cluster Admins" "$ADMIN_OUT"
  else
    msgbox "Cluster Admins" "Corliss refused:

$ADMIN_ERR"
  fi
}

# apply_admins <target>... — give the roster as it stands to each target, and
# say what happened. Corliss first: it is quick and answers in a sentence,
# where the PDS hands the screen to ansible.
apply_admins() {
  local note=""
  if [[ " $* " == *" corliss "* ]]; then
    TERM=ansi whiptail --backtitle "$BACKTITLE" --title "Cluster Admins" \
      --infobox "Asking Corliss…" 8 "$WT_WIDTH"
    if ! apply_admins_corliss; then
      msgbox "Cluster Admins" "Corliss was not updated, and nothing else was tried:

$ADMIN_ERR"
      return 0
    fi
    note="Corliss:
$ADMIN_OUT"
  fi
  if [[ " $* " == *" pds "* ]]; then
    if pds_assigned; then
      [ -z "$note" ] || msgbox "Cluster Admins" "$note

Next, the PDS."
      run_provision pds
      return 0
    fi
    note="${note:+$note

}The PDS has no container ID yet, so there is nothing to update there.
It reads the roster when it is first provisioned."
  fi
  msgbox "Cluster Admins" "$note"
}

do_admins_menu() {
  local choice text who found did handle i args target picked targets
  while true; do
    TERM=ansi whiptail --backtitle "$BACKTITLE" --title "Cluster Admins" \
      --infobox "Reading the admin roster…" 8 "$WT_WIDTH"
    if ! load_admins; then
      msgbox "Cluster Admins" "Could not read the admins.

$ADMIN_ERR"
      return 0
    fi
    text="An admin can approve and revoke members in Corliss and administer
the PDS. The list is the public roster; nothing is stored here.

$(admins_table)${ADM_NOTE:+

$ADM_NOTE}"
    choice="$(whiptail --backtitle "$BACKTITLE" --title "Cluster Admins" \
      --ok-button Select --cancel-button Back \
      --menu "$text" "$(box_height "$text" 12)" "$WT_WIDTH" 4 \
      "Add" " Make someone an admin" \
      "Remove" " End someone's admin authority" \
      "Apply" " Give this list to everything that keeps a copy" \
      "Apply Select" " Choose where to apply it" \
      3>&1 1>&2 2>&3)" || return 0

    if [ "$choice" = Apply ]; then
      apply_admins "${ADMIN_TARGETS[@]}"
    elif [ "$choice" = "Apply Select" ]; then
      args=()
      for target in "${ADMIN_TARGETS[@]}"; do
        args+=("$target" " $(admin_target_label "$target")" ON)
      done
      picked="$(whiptail --backtitle "$BACKTITLE" --title "Cluster Admins" \
        --ok-button Apply --cancel-button Back \
        --checklist "Apply the admin list to: (space toggles)" \
        "$((${#ADMIN_TARGETS[@]} + 8))" "$WT_WIDTH" "${#ADMIN_TARGETS[@]}" \
        "${args[@]}" 3>&1 1>&2 2>&3)" || continue
      # whiptail answers with the chosen tags, each quoted.
      read -r -a targets <<<"${picked//\"/}"
      [ "${#targets[@]}" -gt 0 ] || continue
      apply_admins "${targets[@]}"
    elif [ "$choice" = Add ]; then
      who=""
      while true; do
        who="$(ask "Cluster Admins" "Who? A handle (alice.example.com) or a DID (did:plc:…)." "$who")" || continue 2
        who="$(normalise_who "$who")" && break
        msgbox "Cluster Admins" "That is neither a handle nor a DID."
        who=""
      done
      if found="$(python3 -c "$IDENTITY_LOOKUP" "$who" 2>/dev/null)"; then
        { read -r did; read -r handle; } <<<"$found"
        text="Make this person a cluster admin?

  Handle  ${handle:-(none found)}
  DID     $did"
      else
        text="Make $who a cluster admin?

It could not be looked up from here. Corliss will resolve and verify
it, and refuse if it does not check out."
      fi
      whiptail --backtitle "$BACKTITLE" --title "Cluster Admins" \
        --yes-button "Make admin" --no-button Back \
        --yesno "$text" "$(box_height "$text" 7)" "$WT_WIDTH" || continue
      admin_change add "$who"
    else
      args=()
      for i in "${!ADM_DID[@]}"; do
        args+=("${ADM_DID[$i]}" " ${ADM_HANDLE[$i]}")
      done
      [ "${#args[@]}" -gt 0 ] || { msgbox "Cluster Admins" "There is nobody to remove."; continue; }
      did="$(whiptail --backtitle "$BACKTITLE" --title "Cluster Admins" \
        --ok-button Select --cancel-button Back \
        --menu "Whose admin authority ends?" "$((${#ADM_DID[@]} + 8))" "$WT_WIDTH" \
        "${#ADM_DID[@]}" "${args[@]}" 3>&1 1>&2 2>&3)" || continue
      text="End $did's admin authority?

Members they approved stay members. They stay a member themselves."
      whiptail --backtitle "$BACKTITLE" --title "Cluster Admins" \
        --yes-button Remove --no-button Back \
        --yesno "$text" "$(box_height "$text" 7)" "$WT_WIDTH" || continue
      admin_change remove "$did"
    fi
  done
}

# Take a pasted relay URL apart and put it back together in the form the
# consumer reads. The input arrives in the environment (it carries a password).
# Prints scheme, host, port, tls, "auth" or "", and the rebuilt URL, one per line.
#
# Credentials end at the LAST @, so a username that is an email address or a
# catch-all (*@example.com) needs no escaping from the operator. Each half is
# unquoted then quoted: the consumer percent-decodes, so that keeps the meaning
# of a URL that was already encoded and fixes one that was not.
SMTP_URL_PARSER='
import os, re, sys
from urllib.parse import quote, unquote
raw = os.environ["SMTP_INPUT"].strip()
scheme, rest = raw.split("://", 1)
scheme = scheme.lower()
rest, _, query = rest.partition("?")
userinfo, at, hostport = rest.rpartition("@")
hostport = hostport.split("/", 1)[0]
m = re.fullmatch(r"(\[[0-9a-fA-F:.]+\]|[A-Za-z0-9](?:[A-Za-z0-9.-]*[A-Za-z0-9])?)(?::([0-9]{1,5}))?", hostport)
if not m:
    sys.exit(1)
host, port = m.group(1), m.group(2)
# Bare smtp:// would be unencrypted, so it is read as STARTTLS.
tls = "implicit" if scheme == "smtps" else "starttls"
port = port or ("465" if tls == "implicit" else "587")
user, _, password = userinfo.partition(":")
auth = quote(unquote(user), safe="") + ":" + quote(unquote(password), safe="") + "@" if at and user else ""
suffix = "" if tls == "implicit" else "?tls=required"
print(scheme, host, port, tls, "auth" if auth else "", f"{scheme}://{auth}{host}:{port}{suffix}", sep="\n")
'

# An empty box clears the recipient, which turns alerts off.
do_alert_email_menu() {
  local email out
  while true; do
    email="$(ask "Alert recipient" "Address the monitoring hub emails its alerts to.
Leave empty to turn alerts off." "$ALERT_EMAIL")" || return 0
    [ -z "$email" ] || [[ "$email" =~ ^[^@[:space:]]+@[^@[:space:]]+\.[^@[:space:]]+$ ]] && break
    msgbox "Alert recipient" "That is not an email address."
  done
  if [ -z "$email" ]; then
    out="$(ANSIBLE_NOCOLOR=1 nonint_clear_alert_email 2>&1)" || {
      msgbox "Alert recipient" "Could not clear it.

$(playbook_problem "$out")"; return 0; }
    offer_provision beszel "Alert recipient" "The alert recipient is cleared, so alerts are off."
  else
    out="$(ANSIBLE_NOCOLOR=1 nonint_set_alert_email "$email" 2>&1)" || {
      msgbox "Alert recipient" "It was refused, so nothing was written.

$(playbook_problem "$out")"; return 0; }
    offer_provision beszel "Alert recipient" "Alerts now go to $email."
  fi
}

do_smtp_menu() {
  local choice text host tls port user pass url scheme query out parsed
  # TERM=ansi: see the infobox in do_assign_menu.
  TERM=ansi whiptail --backtitle "$BACKTITLE" --title "Set SMTP" \
    --infobox "Reading the mail relay…" 8 "$WT_WIDTH"
  load_smtp

  text="Outbound mail relay: $(smtp_summary)
Alert recipient: $(alert_summary)

One relay per cluster. The PDS sends invites, confirmations and
password resets through it, and the monitoring hub sends its alerts
to the recipient through it."
  choice="$(whiptail --backtitle "$BACKTITLE" --title "Set SMTP" \
    --ok-button Select --cancel-button Back \
    --menu "$text" "$(box_height "$text" 11)" "$WT_WIDTH" 3 \
    "Set" " Enter the relay's details" \
    "Clear" " Remove the relay and turn mail off" \
    "Alert recipient" " Who the monitoring hub emails" \
    3>&1 1>&2 2>&3)" || return 0

  if [ "$choice" = "Alert recipient" ]; then
    do_alert_email_menu
    return 0
  fi

  if [ "$choice" = Clear ]; then
    [ "$SMTP_STATE" = set ] || { msgbox "Set SMTP" "No relay is set."; return 0; }
    whiptail --backtitle "$BACKTITLE" --title "Set SMTP" \
      --yes-button Clear --no-button Back \
      --yesno "Remove the mail relay? Mail will be off for every service." \
      8 "$WT_WIDTH" || return 0
    if out="$(ANSIBLE_NOCOLOR=1 nonint_clear_smtp 2>&1)"; then
      offer_provision pds "Set SMTP" "The mail relay is cleared."
      offer_provision beszel "Set SMTP" "The mail relay is cleared, so alerts are off."
    else
      msgbox "Set SMTP" "Could not clear the relay.

$(tail -n 12 <<<"$out")"
    fi
    return 0
  fi

  # Host, then how it does TLS, then the port that choice implies. A relay's
  # own setup page usually hands over one whole URL, so the first box takes
  # that too and the rest of the questions are skipped.
  host="$SMTP_HOST" url="" user=""
  while true; do
    host="$(ask "Set SMTP" "Relay host, e.g. smtp.example.com

Or paste the relay's whole URL (smtps://user:password@host:465)." "$host")" || return 0
    if [[ "$host" =~ ^[Ss][Mm][Tt][Pp][Ss]?:// ]]; then
      if parsed="$(SMTP_INPUT="$host" python3 -c "$SMTP_URL_PARSER")"; then
        { read -r scheme; read -r host; read -r port; read -r tls; read -r user; read -r url; } <<<"$parsed"
        break
      fi
      host=""
      msgbox "Set SMTP" "That URL has no host, or its port is not a number."
      continue
    fi
    [[ "$host" =~ ^[A-Za-z0-9]([A-Za-z0-9.-]*[A-Za-z0-9])?$ ]] && break
    msgbox "Set SMTP" "That is not a host name. Enter just the host, or a whole
smtp:// or smtps:// URL."
  done
  if [ -z "$url" ]; then
  tls="$(whiptail --backtitle "$BACKTITLE" --title "Set SMTP" \
    --ok-button Select --cancel-button Back --default-item "${SMTP_TLS:-implicit}" \
    --menu "How does $host secure the connection?" 11 "$WT_WIDTH" 2 \
    "implicit" " TLS from the first byte (smtps, usually port 465)" \
    "starttls" " Upgrades with STARTTLS (smtp, usually port 587)" \
    3>&1 1>&2 2>&3)" || return 0
  if [ "$tls" = implicit ]; then
    scheme=smtps query="" port=465
  else
    # Without tls=required the consumer would talk to the relay unencrypted.
    scheme=smtp query="?tls=required" port=587
  fi
  [ "$tls" = "$SMTP_TLS" ] && [ -n "$SMTP_PORT" ] && port="$SMTP_PORT"
  while true; do
    port="$(ask "Set SMTP" "Port on $host" "$port")" || return 0
    [[ "$port" =~ ^[0-9]{1,5}$ ]] && [ "$port" -ge 1 ] && [ "$port" -le 65535 ] && break
    msgbox "Set SMTP" "The port must be a number from 1 to 65535."
  done

  # Credentials are never pre-filled: the stored ones are not read back.
  user="$(ask "Set SMTP" "Username for $host. Leave empty if the relay needs no sign-in." "")" || return 0
  pass=""
  if [ -n "$user" ]; then
    pass="$(whiptail --backtitle "$BACKTITLE" --title "Set SMTP" \
      --passwordbox "Password for $user" 9 "$WT_WIDTH" 3>&1 1>&2 2>&3)" || return 0
  fi

  # Percent-encode the credentials: usernames are often email addresses, and
  # an unencoded @ / ? or # would change where the URL's host begins. Passed to
  # python in the environment so the password is never an argument.
  url="$(SMTP_USER="$user" SMTP_PASS="$pass" python3 -c '
import os, sys
from urllib.parse import quote
scheme, host, port, query = sys.argv[1:5]
user, password = os.environ["SMTP_USER"], os.environ["SMTP_PASS"]
auth = quote(user, safe="") + ":" + quote(password, safe="") + "@" if user else ""
print(f"{scheme}://{auth}{host}:{port}{query}")
' "$scheme" "$host" "$port" "$query")"
  fi

  text="Set the mail relay to:

  $scheme://$host:$port ($(tls_label "$tls"))
  $([ -n "$user" ] && echo "signing in with the username and password given" || echo "with no sign-in")"
  whiptail --backtitle "$BACKTITLE" --title "Set SMTP" \
    --yes-button Save --no-button Back \
    --yesno "$text" "$(box_height "$text" 7)" "$WT_WIDTH" || return 0

  if out="$(ANSIBLE_NOCOLOR=1 set_smtp "$url" 2>&1)"; then
    offer_provision pds "Set SMTP" "The mail relay is saved."
    offer_provision beszel "Set SMTP" "The mail relay is saved. Alerts use it once a recipient is set."
  else
    msgbox "Set SMTP" "The relay was refused — nothing was written.

$(playbook_problem "$out")"
  fi
}

interactive() {
  local choice
  [ -t 0 ] && [ -t 1 ] || die "the menu needs a terminal — see: scn-config nonint"
  command -v whiptail >/dev/null \
    || die "whiptail is not installed — run: apt-get install whiptail"
  calc_wt_size
  while true; do
    choice="$(whiptail --backtitle "$BACKTITLE" --title "$TITLE" \
      --ok-button Select --cancel-button Finish \
      --menu "" 20 "$WT_WIDTH" 11 \
      "1 Control Node Setup" " Configure this node, check the API token" \
      "2 Cluster Settings" " Proxmox host, domain, membership registry" \
      "3 Container Assignment" " Set the CTID per service" \
      "4 Provision Containers" " Build the assigned services" \
      "5 Cluster Admins" " Who can approve members and run the PDS" \
      "6 Set SMTP" " Outbound mail relay" \
      "7 Set TLS" " How the proxy gets its certificate" \
      "8 Signing Keys" " Rotate the keys services sign tokens with" \
      "9 Versions" " Which release each app deploys" \
      "10 Monitoring Agents" " Install or update the Beszel agents" \
      3>&1 1>&2 2>&3)" || exit 0
    case "$choice" in
      1\ *) do_setup_menu ;;
      2\ *) do_settings_menu ;;
      3\ *) do_assign_menu ;;
      4\ *) do_provision_menu ;;
      5\ *) do_admins_menu ;;
      6\ *) do_smtp_menu ;;
      7\ *) do_tls_menu ;;
      8\ *) do_keys_menu ;;
      9\ *) do_versions_menu ;;
      10\ *) do_monitor_agents_menu ;;
    esac
  done
}

# --- Dispatch ----------------------------------------------------------------
case "${1:-}" in
  "") interactive ;;
  nonint)
    shift
    case "${1:-}" in
      setup) run_setup ;;
      show-domain) nonint_show_domain ;;
      set-domain) shift; nonint_set_domain "$@" ;;
      set-handle-domain) shift; nonint_set_handle_domain "$@" ;;
      clear-handle-domain) shift; nonint_clear_handle_domain "$@" ;;
      show-registry) nonint_show_registry ;;
      set-registry) shift; nonint_set_registry "$@" ;;
      show-proxmox-host) nonint_show_proxmox_host ;;
      set-proxmox-host) shift; nonint_set_proxmox_host "$@" ;;
      show-ctid) nonint_show_ctid ;;
      assign-ctid) shift; nonint_assign_ctid "$@" ;;
      assign-ctid-defaults) nonint_assign_ctid_defaults ;;
      show-admins) nonint_show_admins ;;
      add-admin) shift; nonint_add_admin "$@" ;;
      remove-admin) shift; nonint_remove_admin "$@" ;;
      apply-admins) shift; nonint_apply_admins "$@" ;;
      show-smtp) nonint_show_smtp ;;
      set-smtp) nonint_set_smtp ;;
      clear-smtp) nonint_clear_smtp ;;
      set-alert-email) shift; nonint_set_alert_email "$@" ;;
      clear-alert-email) nonint_clear_alert_email ;;
      show-scn-chat-key) nonint_show_scn_chat_key ;;
      set-scn-chat-key) nonint_set_scn_chat_key ;;
      clear-scn-chat-key) nonint_clear_scn_chat_key ;;
      show-tls) nonint_show_tls ;;
      set-tls) shift; nonint_set_tls "$@" ;;
      show-keys) nonint_show_keys ;;
      rotate-key) shift; nonint_rotate_key "$@" ;;
      retire-key) shift; nonint_retire_key "$@" ;;
      show-versions) nonint_show_versions ;;
      set-version) shift; nonint_set_version "$@" ;;
      clear-version) shift; nonint_clear_version "$@" ;;
      apply-monitor-agents) shift; nonint_apply_monitor_agents "$@" ;;
      print-monitor-agent-install) shift; nonint_print_monitor_agent_install "$@" ;;
      *) usage ;;
    esac
    ;;
  *) usage ;;
esac
