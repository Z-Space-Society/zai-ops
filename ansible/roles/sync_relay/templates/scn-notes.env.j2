# {{ ansible_managed }}
# scn-notes runtime configuration. Read by systemd via EnvironmentFile
# before the process drops privilege — never world-readable (0600 root:root).

SCN_NOTES_DATABASE_URL={{ sync_relay_database_url }}
SCN_NOTES_BIND={{ sync_relay_host }}:{{ sync_relay_port }}

# Phase B. With auth on, the relay refuses to start if any setting below is
# blank, so a half-rendered file fails the smoke test rather than serving open.
SCN_NOTES_REQUIRE_AUTH={{ sync_relay_require_auth | string | lower }}
SCN_NOTES_OIDC_ISSUER={{ sync_relay_oidc_issuer }}
SCN_NOTES_OIDC_JWKS_URL={{ sync_relay_oidc_jwks_url }}
SCN_NOTES_SYNC_AUDIENCE={{ sync_relay_sync_audience }}
SCN_NOTES_MCP_AUDIENCE={{ sync_relay_mcp_audience }}
SCN_NOTES_MCP_BIND={{ sync_relay_host }}:{{ sync_relay_mcp_port }}

# The notes. host (v0.7.0). The URL is checked at startup: an origin, with no
# path and no trailing slash.
SCN_NOTES_PUBLIC_URL={{ sync_relay_public_url }}
SCN_NOTES_PUBLIC_BIND={{ sync_relay_host }}:{{ sync_relay_public_port }}

# Corliss presents this on /internal/. The same group_vars value Corliss
# renders as SYNC_RELAY_SERVICE_TOKEN.
SCN_NOTES_SERVICE_TOKEN={{ sync_relay_service_token }}

RUST_LOG=scn_notes=info,samod=info
