// scn-chat GitHub webhook receiver (spec 0006) — a minimal Node-stdlib HTTP
// service (no deps; Node is already on the CT via the scn_chat role).
//
//   POST /api/gh-webhook
//     X-GitHub-Event: push                    (anything else → 204 ignored)
//     X-Hub-Signature-256: sha256=<hex hmac>  (bad → 400, loud)
//     body.ref == "refs/heads/main"           (any other ref → 204 ignored)
//
// On a valid main push it takes a single-flight lock (atomic mkdir — the same
// primitive flock -n gives), spawns the deploy script detached, and answers
// 202 immediately: GitHub's delivery window is short and the deploy takes
// minutes. Deploy logs land in the journal (journalctl -u scn-chat-webhook).
"use strict";

const http = require("http");
const crypto = require("crypto");
const fs = require("fs");
const { spawn } = require("child_process");

const PORT = Number(process.env.WEBHOOK_PORT || 3001);
const HOOK_PATH = process.env.WEBHOOK_PATH || "/api/gh-webhook";
const SECRET = process.env.WEBHOOK_SECRET || "";
const DEPLOY = process.env.DEPLOY_SCRIPT || "/usr/local/bin/scn-chat-deploy.sh";
const LOCK_DIR = process.env.DEPLOY_LOCK_DIR || "/run/scn-chat-deploy.lockd";

function hmacOk(raw, sig) {
  if (!sig || !sig.startsWith("sha256=")) return false;
  const expected = crypto.createHmac("sha256", SECRET).update(raw).digest("hex");
  const given = Buffer.from(sig.slice("sha256=".length));
  const exp = Buffer.from(expected);
  return given.length === exp.length && crypto.timingSafeEqual(given, exp);
}

const server = http.createServer((req, res) => {
  const respond = (code, obj) => {
    res.writeHead(code, { "Content-Type": "application/json" });
    res.end(JSON.stringify(obj));
  };

  if (req.method !== "POST") {
    res.writeHead(405);
    res.end();
    return;
  }

  const chunks = [];
  req.on("data", (c) => chunks.push(c));
  req.on("error", () => {});
  req.on("end", () => {
    const raw = Buffer.concat(chunks);

    if (!hmacOk(raw, req.headers["x-hub-signature-256"] || "")) {
      console.log(`webhook: rejected bad signature from ${req.socket.remoteAddress}`);
      return respond(400, { ok: false, error: "bad signature" });
    }

    let payload;
    try {
      payload = JSON.parse(raw.toString("utf8"));
    } catch (e) {
      return respond(400, { ok: false, error: "bad json" });
    }

    if (req.headers["x-github-event"] !== "push" || payload.ref !== "refs/heads/main") {
      console.log(`webhook: ignored (event=${req.headers["x-github-event"]} ref=${payload.ref})`);
      return respond(204, { ok: true, ignored: true });
    }

    // Single-flight: one deploy at a time. A skipped delivery self-heals on
    // the next push — the receiver always converges on main HEAD.
    let locked = false;
    try {
      fs.mkdirSync(LOCK_DIR);
      locked = true;
    } catch (e) {
      /* EEXIST → a deploy is already running */
    }
    if (!locked) {
      console.log("webhook: deploy already in progress — skipped");
      return respond(202, { ok: true, skipped: true });
    }

    const child = spawn(DEPLOY, [], { detached: true, stdio: "ignore" });
    child.on("error", (err) => {
      console.log(`webhook: spawn failed — ${err.message}`);
      try { fs.rmdirSync(LOCK_DIR); } catch (e) { /* already gone */ }
      respond(500, { ok: false, error: "spawn failed" });
    });
    child.unref();

    console.log(`webhook: deploy started (${payload.after || "?"})`);
    respond(202, { ok: true, started: true });
  });
});

server.listen(PORT, "0.0.0.0", () => {
  console.log(`scn-chat webhook receiver listening on :${PORT}${HOOK_PATH}`);
});