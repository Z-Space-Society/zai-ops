#!/usr/bin/env bash
# zai-set-console — thin wrapper over set-console.yml. Record the admin
# console's per-cluster settings:
#
#   zai-set-console client_key hvc_xxxxx           # the HappyView public client
#   zai-set-console service_did did:plc:xxxxx      # anchors the admin roster
#   zai-set-console registry_space_uri at://...    # optional; identity panel only
#
# None of these is a secret — all three ship inside the browser bundle or are
# published at a public URL — so they go in the runtime inventory, not the vault.
#
# Lives in the repo's bin/ (on PATH via /etc/profile.d/zai-ops.sh) and runs in
# place — the script you run is always the one in git, no installed copy to drift.
# No logic lives here; the playbook validates the key against its allowlist and
# persists the value.
set -euo pipefail
if [[ $# -lt 2 ]]; then
  echo "usage: zai-set-console <key> <value> [extra ansible args]" >&2
  echo "  keys: client_key | service_did | registry_space_uri" >&2
  exit 64
fi
key="$1"; shift
value="$1"; shift
# cd to the ansible dir (sibling of this bin/) so ansible.cfg loads no matter the
# caller's CWD — it supplies the inventory (relative: inventory/) and the vault
# password file. Self-locating off this script's path (not hardcoded) so the same
# script works from any checkout: /opt/zai-ops on the box, a dev tree elsewhere.
cd "$(dirname "$(readlink -f "$0")")/../ansible"
exec ansible-playbook set-console.yml \
  -e "key=$key" -e "value=$value" "$@"
