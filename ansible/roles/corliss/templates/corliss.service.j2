# {{ ansible_managed }}
[Unit]
Description=Corliss (ATProto -> OIDC login bridge)
After=network-online.target
Wants=network-online.target

[Service]
User={{ corliss_user }}
Group={{ corliss_group }}
EnvironmentFile={{ corliss_env_file }}
Environment=HOME={{ corliss_home }}
# Run gunicorn from the venv directly (absolute path — no PATH reliance under
# systemd), against the synced app source. HOST/PORT are pinned here rather
# than read from the env file so the bind is unambiguous.
WorkingDirectory={{ corliss_src }}
ExecStart={{ corliss_venv }}/bin/gunicorn corliss.wsgi:application --bind {{ corliss_host }}:{{ corliss_port }} --workers {{ corliss_gunicorn_workers }}
Restart=on-failure
RestartSec=5
TimeoutStartSec=60

# Hardening: persistent state lives in Postgres, not on this CT. ProtectSystem=
# strict makes / read-only (the signing keys under /etc/corliss/keys and the
# env file stay READABLE — strict only blocks writes); PrivateTmp gives a
# scratch /tmp; ProtectHome hides /home + /root (unaffected — everything is
# under /opt and /etc). ReadWritePaths re-opens just the daemon's own home.
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths={{ corliss_home }}

[Install]
WantedBy=multi-user.target
