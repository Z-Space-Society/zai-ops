# {{ ansible_managed }}
# Caddy reverse proxy — routes are git-tracked (caddy_proxy_hosts), not UI state.

{
{% if caddy_tls_mode == 'origin_ca' %}
    # We supply origin TLS ourselves (Cloudflare Origin CA cert); never let Caddy
    # try to obtain its own certs over ACME — the Debian package has no DNS
    # plugin and ACME would fail behind Cloudflare anyway.
    auto_https disable_redirects
{% elif caddy_tls_mode == 'acme' %}
    # Caddy obtains and renews its own Let's Encrypt certs here, because nothing
    # in front of this edge terminates TLS and browsers must trust it directly.
    #
    # disable_redirects reads as if it turns that off. It does not: it removes
    # only Caddy's automatic HTTP-to-HTTPS redirect, and certificate management
    # carries on. The :80 block below already provides that redirect itself,
    # with the /healthz exception, identically in both cert-bearing modes.
    auto_https disable_redirects
{% if caddy_acme_email %}
    email {{ caddy_acme_email }}
{% endif %}
{% else %}
    # No Origin CA cert in the vault yet — serve plain HTTP only (no ACME).
    auto_https off
{% endif %}

    # Default admin endpoint, localhost-only — `caddy reload` uses it. Not LAN-exposed.
    admin localhost:2019
{% if caddy_trusted_proxies %}

    # Preserve the X-Forwarded-* headers sent by a proxy in FRONT of this one,
    # instead of overwriting them with this connection's own scheme. Needed when
    # something else terminates TLS upstream: without it every app behind here
    # sees X-Forwarded-Proto: http and builds http:// absolute URLs for a client
    # that arrived over https, which breaks Django redirects and OIDC callbacks.
    #
    # Only these addresses are trusted. Overwriting is the correct default for a
    # directly-exposed edge, because it stops a client forging the header.
    #
    # Requires Caddy >= 2.7; on 2.6.2 this is a hard config error, not a warning.
    servers {
        trusted_proxies static {{ caddy_trusted_proxies | join(' ') }}
    }
{% endif %}
}

{% if caddy_tls_mode == 'origin_ca' %}
# Reusable snippet: the wildcard Cloudflare Origin CA cert covers every route.
(origin_tls) {
    tls {{ caddy_cert_path }} {{ caddy_key_path }}
}

{% endif %}
# Plain HTTP catch-all: health probe, plus (when TLS is on) redirect everything
# else to HTTPS. handle blocks are mutually exclusive and evaluated in order, so
# /healthz returns "ok" instead of being caught by the redirect. Keeps the config
# valid (and the CT answerable) even when caddy_proxy_hosts is empty.
{% if caddy_tls_mode == 'acme' %}
#
# This block does not shadow the ACME HTTP-01 challenge, though it looks as if
# the catch-all redirect would bounce /.well-known/acme-challenge/ to HTTPS. Caddy
# wires its challenge handler in ahead of site routes on the HTTP port, so a
# challenge for a name it manages is answered before either handle runs.
{% endif %}
:80 {
    handle /healthz {
        respond "ok" 200
    }
{% if caddy_tls_enabled | bool %}
    handle {
        redir https://{host}{uri}
    }
{% endif %}
}

{% if caddy_tls_mode == 'acme' %}
# Each site below is a bare hostname with no `tls` directive, and that absence is
# the mechanism: it is what puts the name under Caddy's own certificate
# management. A `tls` file pair here would take the name back out of it.
{% endif %}
{% for h in caddy_proxy_hosts %}
{% if caddy_tls_enabled | bool %}
{{ h.domain }} {
{% if caddy_tls_mode == 'origin_ca' %}
    import origin_tls
{% endif %}
{% else %}
http://{{ h.domain }} {
{% endif %}
{% if h.root is defined %}
    # A static route: this entry names a directory instead of an upstream
    # service, so Caddy serves the files itself — no CT, no daemon, no port.
    # For pre-built browser apps; everything else here proxies.
    #
    # NO ROUTE CURRENTLY USES THIS. It served the manage_console SPA until that
    # role was deleted, and is kept because it is generic static-file support
    # rather than anything console-specific — it was a separate commit for that
    # reason. Correct and inert with no `root:` entry in caddy_proxy_hosts.
    root * {{ h.root }}
    # SPA fallback, and it is load-bearing rather than boilerplate: a
    # single-page app owns client-side routes that have no file behind them
    # (an OAuth callback landing on /oauth/callback, say). Without this, that
    # request 404s and sign-in fails *silently* — the token exchange has
    # already happened, so the only symptom is a user who never lands. Any path
    # that isn't a real file resolves to index.html and the app routes it.
    #
    # The same fallback is a trap in the other direction: a MISSING file also
    # resolves to index.html, so a build that never emitted its client metadata
    # serves HTML at the client-id URL, the member's PDS gets HTML where it
    # expects JSON, and sign-in dies at the consent screen with no 404 anywhere
    # to explain it. Any role adding a `root:` route back should assert its
    # critical files exist rather than trust this to reveal their absence.
    try_files {path} /index.html
    file_server
{% elif h.redirects is defined and h.redirects %}
    # handle blocks are mutually exclusive and evaluated in order (same idiom
    # as the :80 catch-all above) — each redirect is checked before falling
    # through to the catch-all reverse_proxy.
{% for r in h.redirects %}
    handle {{ r.from }} {
{% if r.skip_if_cookie is defined %}
        # open-webui's own OIDC callback always finishes by redirecting the
        # browser back to this exact path (its frontend reads the just-set
        # session cookie there and completes login client-side) — a blind
        # redirect here catches that completion request too and bounces it
        # into a fresh OIDC round-trip forever (confirmed: the app-side log
        # shows a successful token exchange on every cycle, never landing).
        # No dedicated Caddy `cookie` matcher exists, so check the raw Cookie
        # header via regex, anchored on a header boundary so it can't false-
        # match a differently-named cookie that merely contains this substring.
        # Nested handle blocks (not a handle + a bare sibling directive) are
        # required for mutual exclusion here — same guarantee the outer
        # handle/handle catch-all pair below already relies on.
        @{{ r.skip_if_cookie }}_present header_regexp Cookie (^|;\s*){{ r.skip_if_cookie }}=
        handle @{{ r.skip_if_cookie }}_present {
            reverse_proxy {{ hostvars[h.service].ansible_host }}:{{ h.port }}
        }
        handle {
            # redir's Caddyfile grammar is `redir [<matcher>] <to> [<code>]` —
            # with exactly two bare args Caddy reads them as <matcher> <to>,
            # not <to> <code> (confirmed via `caddy adapt`: a 2-arg redir here
            # silently became a matcher on r.to and a Location header literally
            # "302"). The `*` forces an unambiguous 3-arg parse; real scoping
            # already comes from the enclosing handle blocks, so `*` (match
            # everything that reaches here) is correct, not redundant.
            redir * {{ r.to }} {{ r.code | default(302) }}
        }
{% else %}
        # redir's Caddyfile grammar is `redir [<matcher>] <to> [<code>]` — with
        # exactly two bare args Caddy reads them as <matcher> <to>, not <to>
        # <code> (confirmed via `caddy adapt`: a 2-arg redir here silently
        # became a matcher on r.to and a Location header literally "302").
        # The `*` forces an unambiguous 3-arg parse; real scoping already
        # comes from the enclosing handle block, so `*` (match everything
        # that reaches here) is correct, not redundant.
        redir * {{ r.to }} {{ r.code | default(302) }}
{% endif %}
    }
{% endfor %}
    handle {
        reverse_proxy {{ hostvars[h.service].ansible_host }}:{{ h.port }}
    }
{% else %}
    reverse_proxy {{ hostvars[h.service].ansible_host }}:{{ h.port }}
{% endif %}
}
{% endfor %}
