# Rendered by the scn_chat role. Regenerate via ansible, don't hand-edit.
NODE_ENV=production
DATABASE_URL={{ scn_chat_database_url }}
DATA_DIR={{ scn_chat_data_dir }}
PORT={{ scn_chat_port }}
LOG_LEVEL={{ scn_chat_log_level }}

SECRET_KEY={{ scn_chat_secret_key }}
SECRET_KEYS_OLD=
{# The atproto OAuth client key (ADR-0011): a JSON array of private JWKs, the
   current key first, which starts new sessions, then the key being rotated
   out, which still refreshes the sessions that began on it. One line and
   unquoted, like the PDS's PDS_OAUTH_KEYS_JWK_SET: systemd keeps the quotes
   inside an unquoted value as they are. #}
OAUTH_PRIVATE_KEYS={{ scn_chat_oauth_keys | map('private_jwk') | list | to_json }}

# Comma-separated admins, from the cluster admin roster (tasks/roster.yml).
ADMIN_DIDS={{ scn_chat_admin_dids | join(',') }}

# The OAuth client_id is <PUBLIC_URL>/oauth-client-metadata.json and the app's
# did:web derives from the same origin, so this is decided once (spec 0005 Q3).
# Production refuses `raw`; permission-set is the shipped mode.
PUBLIC_URL={{ scn_chat_public_url }}
OAUTH_SCOPE_MODE=permission-set
PLC_URL={{ scn_chat_plc_url }}
# False keeps DID and PDS resolution, the plugins' fetches and members' own
# model endpoints off 10.1.1.0/24: this CT sits on vmbr1 beside postgres, redis
# and litellm. The admin's configured provider is called directly and is the
# admin's to point at LiteLLM's internal address.
ALLOW_PRIVATE_NETWORKS=false
